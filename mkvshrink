# ---------------------------- Cues check ------------------------------------
read -r -d '' CUES_PY <<'CUESPY' || true
import os, sys
# 1C53BB6B is the Cues element. The SeekHead names it too, inside a SeekID
# element, which on the wire is 53 AB 84 followed by those four bytes. A match
# preceded by 53 AB 84 is only a reference to Cues, not Cues itself.
CUES = b"\x1c\x53\xbb\x6b"
REF = b"\x53\xab\x84" + CUES


def scan(buf):
    seen_ref = False
    i = buf.find(CUES)
    while i != -1:
        if i >= 3 and buf[i - 3:i + 4] == REF:
            seen_ref = True
        else:
            return True, seen_ref
        i = buf.find(CUES, i + 1)
    return False, seen_ref


p = sys.argv[1]
try:
    size = os.path.getsize(p)
    ref = False
    with open(p, "rb") as fh:
        present, r = scan(fh.read(16 << 20)); ref = ref or r
        if not present and size > (16 << 20):
            fh.seek(max(0, size - (16 << 20)))
            present, r = scan(fh.read(16 << 20)); ref = ref or r
    print("ok" if present else ("dangling" if ref else "missing"))
except Exception:
    print("unknown")
CUESPY

# ---------------------------- verification ----------------------------------
# Exit status zero means FFmpeg and mkvmerge were happy. It does not mean the
# file plays. Every one of these checks corresponds to a file that passed the
# exit status and was still broken.
# verify_output SRC OUT -> 0 pass, 1 fail. Sets V_NOTES.
verify_output() {
  local src="$1" out="$2" fail=0
  V_NOTES=""
  local sd od
  sd="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$src" \
        2>/dev/null | head -1 | tr -d '[:space:],')"
  od="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$out" \
        2>/dev/null | head -1 | tr -d '[:space:],')"
  if [[ "$sd" =~ ^[0-9.]+$ && "$od" =~ ^[0-9.]+$ ]]; then
    local verdict
    verdict="$(python3 -c '
import sys
a, b = float(sys.argv[1]), float(sys.argv[2])
d = b - a
print("%.2f %.2f %+.2f %s" % (a, b, d, "ok" if abs(d) <= 1.0 else "drift"))
' "$sd" "$od")"
    read -r _s _o _d _v <<<"$verdict"
    if [[ "$_v" != "ok" ]]; then
      fail=1; V_NOTES="${V_NOTES}length drift ${_d}s; "
      warn "Length check: source ${_s}s but output ${_o}s (${_d}s). The video is
      not the same length as the source, so the audio will drift."
    else
      say "Length check: source ${_s}s, output ${_o}s (${_d}s)"
    fi
  else
    fail=1; V_NOTES="${V_NOTES}length unreadable; "
  fi

  # Right length and still black for the first minute is a real failure mode,
  # so decode the head of the file and count what comes out.
  local frames
  frames="$(ffmpeg -v error -stats -nostdin -i "$out" -map 0:v:0 -t 3 -f null - 2>&1 \
    | tr '\r' '\n' | grep -o 'frame= *[0-9]*' | tail -1 | tr -dc '0-9' || true)"
  frames="${frames:-0}"
  if [[ "$frames" -lt 10 ]]; then
    fail=1; V_NOTES="${V_NOTES}only $frames frames in the first 3s; "
    warn "Playability check: only $frames frames decoded from the first three
      seconds. Sound will play over a black picture."
  else
    say "Playability check: $frames frames from the first three seconds"
  fi

  local cues
  cues="$(python3 -c "$CUES_PY" "$out" || true)"
  case "${cues:-unknown}" in
    ok|unknown) ;;
    *) fail=1; V_NOTES="${V_NOTES}no Cues index; "
       warn "Playability check: no Cues index, so the mux never finished." ;;
  esac

  local chap
  chap="$(ffprobe -v error -show_chapters -show_entries format=duration -of json "$out" \
    2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
ch = d.get("chapters", [])
if not ch:
    sys.exit(0)
try:
    dur = float(d["format"]["duration"])
    last = max(float(c.get("end_time", 0)) for c in ch)
except Exception:
    sys.exit(0)
print(("bad " if last > dur + 1 else "ok ") + "%d %.2f %.2f" % (len(ch), last, dur))
' || true)"
  read -r _cv _cn _cl _cd <<<"${chap:-}" || true
  if [[ "${_cv:-}" == "bad" ]]; then
    fail=1; V_NOTES="${V_NOTES}chapters end past the end of the file; "
    warn "Chapter check: the last of ${_cn} chapters ends at ${_cl}s but the file
      is only ${_cd}s long. Players that reject this show a black screen."
  elif [[ "${_cv:-}" == "ok" ]]; then
    say "Chapter check: ${_cn} chapters, last ends at ${_cl}s of ${_cd}s"
  fi

  # Silent until a player refuses the file, which is the worst kind of fault.
  if [[ "${STEREO:-0}" != "0" ]]; then
    local ost
    ost="$(mkvmerge -J "$out" 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for t in d.get("tracks",[]):
    if t.get("type")=="video":
        p=t.get("properties",{})
        print("%s %s" % (p.get("stereo_mode",0), p.get("display_dimensions","")))
        break' || true)"
    read -r _os _od <<<"${ost:-}" || true
    if [[ "${_os:-0}" != "${STEREO}" || "${_od:-}" != "${DISP}" ]]; then
      fail=1; V_NOTES="${V_NOTES}stereo/display not restored; "
      warn "Stereo check: source was mode ${STEREO} at ${DISP}, output is
      mode ${_os:-?} at ${_od:-?}. Jellyfin refuses files whose declared
      display is smaller than the coded frame."
    else
      say "Stereo check: mode ${STEREO}, display ${DISP}"
    fi
  fi

  return $fail
}

# ---------------------------- the actual work -------------------------------
# shrink_one SRC ACTION AUDIO SUBS TRACKSRC
# Echoes a path to the finished file that is guaranteed to sit on the same
# filesystem as the destination, copying it there if it does not already.
land_output() {
  local o="$1" dst="$2" base="$3"
  local devo devd
  devo="$(stat -f%d "$(dirname "$o")" 2>/dev/null || stat -c%d "$(dirname "$o")" 2>/dev/null || echo x)"
  devd="$(stat -f%d "$dst" 2>/dev/null || stat -c%d "$dst" 2>/dev/null || echo y)"
  if [[ "$devo" == "$devd" ]]; then
    echo "$o"; return 0
  fi
  local landed="${dst}/${base}.mkvshrink.landing.mkv"
  cp "$o" "$landed" || { rm -f "$landed"; return 1; }
  # A short copy is a valid MKV of the wrong length, and every check that
  # mattered ran against the file on the scratch disk, not this one.
  local a b
  a="$(filesize "$o")"; b="$(filesize "$landed")"
  if [[ "$a" != "$b" ]]; then
    rm -f "$landed"; return 1
  fi
  rm -f "$o"
  echo "$landed"
}

shrink_one() {
  local src="$1" action="$2" akeep="$3" skeep="$4" tracksrc="$5"
  local dir base work stage out
  dir="$(cd "$(dirname "$src")" && pwd)"
  base="$(basename "${src%.*}")"
  work="${TMPROOT:-$dir}"
  mkdir -p "$work"
  stage="${work}/${base}.mkvshrink.stage.mkv"
  out="${work}/${base}.mkvshrink.new.mkv"

  local keepwork=0
  cleanup_one() { [[ $keepwork -eq 1 ]] || rm -f "$stage" "$out" "${work}/${base}.chapters.xml" \
                    "${work}/${base}.tags.xml" "${work}/${base}.srctags.xml" \
                    "${dir}/${base}.mkvshrink.landing.mkv"; }

  local t0; t0=$(date +%s)
  local settings="tracks=$tracksrc"

  if [[ "$action" == "shrink" ]]; then
    say "Encoding $(basename "$src")"
    mach "@@stage encode $src"
    # DURATION comes from the probe, so the percentage and the ETA are against
    # the real length of this file rather than an assumption.
    PROGRESS_DUR="${DURATION:-0}"
    PROGRESS_NAME="$(basename "$src")"
    if ! encode_video "$src" "$stage"; then
      PROGRESS_DUR=""; PROGRESS_NAME=""
      warn "encode failed, leaving $(basename "$src") alone"
      cleanup_one; return 1
    fi
    PROGRESS_DUR=""; PROGRESS_NAME=""
    [[ $DRYRUN -eq 1 ]] && { cleanup_one; return 0; }
    if [[ "$ENCODER" == "vt" ]]; then
      settings="$settings vt q$VTQUALITY"
    else
      settings="$settings x265 crf$CRF $PRESET"
    fi
    [[ $TENBIT -eq 1 ]] && settings="$settings 10bit"
  else
    say "Remuxing $(basename "$src"), no re-encode"
    mach "@@stage strip $src"
    settings="$settings strip-only"
  fi

  # --- chapters ------------------------------------------------------------
  # Extracted and stripped rather than copied, because a source that was itself
  # written by FFmpeg carries a ChapterTimeEnd on every chapter. Matroska only
  # defines that for ordered editions, and a player that reads it as one builds
  # a broken virtual timeline: no picture until the first chapter boundary.
  local chapxml="${work}/${base}.chapters.xml"
  local -a chapargs=()
  if mkvextract "$src" chapters > "$chapxml" 2>/dev/null && [[ -s "$chapxml" ]]; then
    python3 -c "$CHAPSTRIP_PY" "$chapxml"
    chapargs=(--chapters "$chapxml")
  else
    rm -f "$chapxml"
    chapargs=(--no-chapters)
  fi

  # --- tags ----------------------------------------------------------------
  local srctags="${work}/${base}.srctags.xml" tagxml="${work}/${base}.tags.xml"
  mkvextract "$src" tags > "$srctags" 2>/dev/null || : > "$srctags"
  [[ -s "$srctags" ]] || srctags=""
  python3 -c "$TAGMERGE_PY" "$srctags" "$tagxml" \
    MKVSHRINK_VERSION "$VERSION build $BUILD" \
    MKVSHRINK_SETTINGS "$settings" \
    MKVSHRINK_SOURCE_SIZE "$(filesize "$src")"

  # --- mux -----------------------------------------------------------------
  # mkvmerge writes the file you keep. FFmpeg's output and MKVToolNix's contain
  # identical streams and agree on every field mkvdiff checks, and Jellyfin's
  # Android TV client on an Nvidia Shield still refuses to direct play FFmpeg's
  # and plays MKVToolNix's.
  #
  # Audio and subtitles come straight from the source here rather than through
  # the encode, so they are never touched by FFmpeg at all and keep their
  # languages, names and flags without anything having to restore them.
  local -a mkv=(mkvmerge -q -o "$out")
  local vsrc="$src"
  if [[ "$action" == "shrink" ]]; then
    mkv+=(--no-chapters --no-global-tags --no-track-tags)
    [[ -n "${VID_LANG:-}" ]] && mkv+=(--language "0:${VID_LANG}")
    [[ -n "${VID_NAME:-}" ]] && mkv+=(--track-name "0:${VID_NAME}")
    mkv+=(--default-track-flag 0:1 "$stage")
    mkv+=(--no-video)
  fi
  mkv+=(--no-chapters --no-global-tags)
  # If the track that carried the default flag is one of the ones being
  # dropped, the output ends up with no default track at all and players pick
  # arbitrarily. This has to be decided against the list actually being kept,
  # which may have been edited by hand, not against what the rules proposed.
  local fix
  if [[ -n "$akeep" && "$akeep" != "none" ]]; then
    mkv+=(--audio-tracks "$akeep")
    while IFS= read -r fix; do
      [[ -n "$fix" ]] && mkv+=(--default-track-flag "$fix")
    done <<< "$(default_flag_args "$akeep" "${AUDIO_DEFAULT_ID:-}")"
  else
    mkv+=(--no-audio)
  fi
  if [[ -n "$skeep" && "$skeep" != "none" ]]; then
    mkv+=(--subtitle-tracks "$skeep")
    while IFS= read -r fix; do
      [[ -n "$fix" ]] && mkv+=(--default-track-flag "$fix")
    done <<< "$(default_flag_args "$skeep" "${SUBS_DEFAULT_ID:-}")"
  else
    mkv+=(--no-subtitles)
  fi
  mkv+=("$vsrc")
  mkv+=("${chapargs[@]}")
  mkv+=(--global-tags "$tagxml")

  if [[ $DRYRUN -eq 1 ]]; then
    printf '%q ' "${mkv[@]}"; echo
    cleanup_one; return 0
  fi

  if ! "${mkv[@]}"; then
    warn "mkvmerge failed on $(basename "$src"). The original is untouched."
    cleanup_one; return 1
  fi
  rm -f "$stage"

  # --- stereo mode and display dimensions ----------------------------------
  # A Full-SBS file must declare 3840x2160, not the per-eye 1920x1080 a plain
  # reading of the spec suggests. Both express 16:9; Jellyfin refuses the file
  # whose declared display is smaller than its coded frame.
  if [[ "${STEREO:-0}" != "0" || -n "${DISP:-}" ]]; then
    local -a pe=(mkvpropedit "$out" --edit track:v1)
    [[ "${STEREO:-0}" != "0" ]] && pe+=(--set "stereo-mode=${STEREO}")
    if [[ -n "${DISP:-}" ]]; then
      pe+=(--set "display-width=${DISP%%x*}" --set "display-height=${DISP##*x}")
    fi
    "${pe[@]}" >/dev/null || warn "could not restore stereo mode on $(basename "$out")"
  fi

  # --- verify --------------------------------------------------------------
  mach "@@stage verify $src"
  if ! verify_output "$src" "$out"; then
    keepwork=1
    warn "$(basename "$src") failed verification: ${V_NOTES}
      The original is untouched. The failed output is at:
        $out"
    mach "@@failed $src"
    return 1
  fi

  if [[ $VERIFY_FULL -eq 1 && "$action" == "shrink" ]]; then
    say "Measuring PSNR over the whole file"
    local fp
    fp="$(ffmpeg -hide_banner -nostdin -i "$src" -i "$out" -lavfi "[0:v]setpts=N[a];[1:v]setpts=N[b];[a][b]psnr" -f null - 2>&1 \
      | grep -o 'average:[0-9.]*' | tail -1 | cut -d: -f2 || true)"
    if [[ -n "$fp" ]] && ! python3 -c 'import sys;sys.exit(0 if float(sys.argv[1])>=float(sys.argv[2]) else 1)' \
         "$fp" "$MINPSNR"; then
      keepwork=1
      warn "Full-file PSNR ${fp} dB is below the ${MINPSNR} dB floor. Rejected.
      The original is untouched. The output is at: $out"
      return 1
    fi
    say "Full-file PSNR: ${fp} dB"
  fi

  # --- replace -------------------------------------------------------------
  local newsize oldsize
  newsize="$(filesize "$out")"; oldsize="$(filesize "$src")"
  local saved
  saved="$(python3 -c 'import sys
o,n=int(sys.argv[1]),int(sys.argv[2])
print("%.1f" % (100.0*(o-n)/o) if o else "0.0")' "$oldsize" "$newsize")"

  # Get the finished file onto the destination filesystem before anything is
  # renamed. With --temp pointing at a scratch disk, "mv" from there to the NAS
  # is a copy rather than a rename, so it is neither atomic nor instant. In
  # folder mode the original has already been moved aside by then, and an
  # interrupted copy would leave a partial file and no original in place. Copy
  # first, check it arrived whole, and only then start moving things around.
  if ! out="$(land_output "$out" "$dir" "$base")"; then
    warn "could not copy the finished file to $dir, leaving everything alone"
    keepwork=1; return 1
  fi

  case "$REPLACE" in
    none)
      local keepat="${dir}/${base}.shrunk.mkv"
      mv -f "$out" "$keepat"
      say "Wrote $(basename "$keepat"), saving ${saved}%. Original untouched."
      mach "@@done $keepat $saved"
      ;;
    folder)
      local rdir
      if [[ -n "$REPLACEDIR" ]]; then
        rdir="${REPLACEDIR}${dir}"
      else
        rdir="${dir}/_replaced"
      fi
      mkdir -p "$rdir"
      # Move the original out first, then the new file in. The reverse order
      # has a moment where the only copy of the film is the one that has just
      # been written, and that is the moment the disk fills up.
      if ! mv -f "$src" "${rdir}/$(basename "$src")"; then
        warn "could not move the original aside, leaving everything alone"
        keepwork=1; return 1
      fi
      mv -f "$out" "${dir}/$(basename "${src%.*}").mkv"
      say "Replaced $(basename "$src"), saving ${saved}%. Original in $(basename "$rdir")/"
      mach "@@done $src $saved"
      ;;
    insitu)
      # Rename over the top rather than truncate and rewrite: a rename is
      # atomic on the same filesystem, so an interruption leaves one whole file
      # rather than half of one.
      mv -f "$out" "${dir}/$(basename "${src%.*}").mkv"
      [[ "${src##*.}" == "mkv" ]] || rm -f "$src"
      say "Replaced $(basename "$src") in place, saving ${saved}%"
      mach "@@done $src $saved"
      ;;
  esac

  local el=$(( $(date +%s) - t0 ))
  say "Finished in $((el/60))m $((el%60))s"
  cleanup_one
  return 0
}

# ---------------------------- file discovery --------------------------------
collect_inputs() {
  local p
  FILES=()
  for p in "$@"; do
    # Resolve to an absolute path here, at the one point every input passes
    # through. A plan written from a relative argument records relative paths,
    # and --apply run from anywhere else then reports every row as missing.
    # No realpath: it is not on a stock macOS.
    p="$(abspath "$p")"
    if [[ -f "$p" ]]; then
      FILES+=("$p")
    elif [[ -d "$p" ]]; then
      local -a found=()
      if [[ $RECURSE -eq 1 ]]; then
        while IFS= read -r -d '' f; do found+=("$f"); done \
          < <(find "$p" -type f -name '*.mkv' -not -path '*/_replaced/*' -print0 | sort -z)
      else
        while IFS= read -r -d '' f; do found+=("$f"); done \
          < <(find "$p" -maxdepth 1 -type f -name '*.mkv' -print0 | sort -z)
      fi
      FILES+=(${found[@]+"${found[@]}"})
    else
      warn "no such file or folder: $p"
    fi
  done
}

# ---------------------------- plan ------------------------------------------
# The reason column carries the skip reason, and any audio language that lost
# every track. Both are things you want to see before an unattended sweep, and
# neither is visible in the ID columns.
plan_reason() {
  local r=""
  [[ -n "${D_REASON:-}" ]] && r="$D_REASON"
  if [[ -n "${AUDIO_LOST_LANGS:-}" ]]; then
    [[ -n "$r" ]] && r="$r,"
    r="${r}drops-audio:${AUDIO_LOST_LANGS}"
  fi
  echo "${r:--}"
}

plan_row() {  # emits one TSV row for the current probe state
  # Reason last, so sorting by an existing column still works and a path
  # containing anything odd cannot shift it. A skip row without a reason is
  # useless: "too small to bother with" and "re-encoding would make it bigger"
  # sort identically at 0.0% and want completely different responses.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$D_ACTION" "${PLAN_AUDIO}" "${PLAN_SUBS}" "${PLAN_SAVE}" \
    "${PE_PSNR:--}" "${PLAN_SIZE}" "${PLAN_PRED}" "${SEGUID:-}" "$1" "$(plan_reason)"
}

# analyse FILE -> fills D_ACTION, PLAN_*
analyse() {
  local f="$1"
  probe_file "$f"
  if [[ "$P_OK" != "1" ]]; then
    D_ACTION="skip"; D_REASON="${P_ERR:-unreadable}"
    PLAN_AUDIO="-"; PLAN_SUBS="-"; PLAN_SAVE="0"; PLAN_SIZE="0"; PLAN_PRED="0"
    return 0
  fi
  [[ -n "${WARNINGS:-}" ]] && warn "$(basename "$f"): $WARNINGS"
  # Loud, because it is the one selection mistake you cannot see in the plan's
  # ID columns and cannot undo once the original is gone.
  if [[ -n "${AUDIO_LOST_LANGS:-}" ]]; then
    warn "$(basename "$f"): dropping every audio track in: ${AUDIO_LOST_LANGS}.
      Keeping: ${AUDIO_KEEP_LANGS:-none}. If one of those is the original
      language of this film, add it: --audio-langs ${AUDIOLANGS},${AUDIO_LOST_LANGS%%,*}"
  fi
  [[ "${ALIGNED:-1}" == "1" ]] || warn "$(basename "$f"): mkvmerge and ffprobe
      disagree on the track order, so per-track sizes are not available. Video
      size falls back to the file minus the tracks it could identify, and the
      saving from dropping tracks cannot be counted. The encode prediction is
      still sound; the strip saving will read low."
  decide

  PLAN_AUDIO="${AUDIO_KEEP:-}"; [[ -n "$PLAN_AUDIO" ]] || PLAN_AUDIO="none"
  PLAN_SUBS="${SUBS_KEEP:-}";   [[ -n "$PLAN_SUBS" ]]  || PLAN_SUBS="none"
  PLAN_SIZE="$(python3 -c 'import sys;print("%.0f"%(int(sys.argv[1])/1048576))' "${TOTAL_BYTES:-0}")"
  PLAN_PRED="$PLAN_SIZE"; PLAN_SAVE="0.0"

  if [[ "$D_ACTION" == "skip" ]]; then
    say "$(basename "$f"): skipped, $D_REASON"
    return 0
  fi

  if [[ "$D_ACTION" == "shrink" ]]; then
    local work="${TMPROOT:-$(dirname "$f")}"
    mkdir -p "$work"
    if probe_encode "$f" "$work" && [[ -n "${PE_RATIO:-}" ]]; then
      read -r PLAN_PRED PLAN_SAVE <<<"$(python3 -c '
import sys
vid, other, total, ratio = (int(sys.argv[1]), int(sys.argv[2]),
                            int(sys.argv[3]), float(sys.argv[4]))
if not total:
    print("0 0.0"); raise SystemExit
drop = int(sys.argv[5])
# The video estimate comes from a track statistics tag when the file carries
# one and from bitrate times duration when it does not. The fallback is a
# guess, and on a file whose reported bitrate does not match its actual
# content it can exceed the size of the whole file. That drives the
# prediction to nonsense like -212%, which then argues loudly for or against
# re-encoding on the strength of a number that was never possible. The video
# cannot be larger than the file minus the other tracks, so say so.
room = max(0, total - other - drop)
if vid > room:
    vid = room
# The other direction, and the one that silently rejected good files. When
# mkvmerge and ffprobe disagree on track order the per-track sizes are
# abandoned and this arrives as zero. The prediction then reads
# 0 * ratio + other + overhead, overhead swells to cover the whole file, and
# the answer is "saves 0.0%" for a file that would have halved. It skipped
# Akira at ratio 0.48. Video is nearly all of a video file, so when there is
# no per-track figure, treat everything that is not a known track as video.
if vid <= 0:
    vid = room
# Container and index overhead is small but real, so account for what is not
# a track rather than assume video plus tracks equals the file.
overhead = max(0, total - vid - other - drop)
pred = int(vid * ratio) + other + overhead
print("%d %.1f" % (pred / 1048576, 100.0 * (total - pred) / total))
' "${VID_BYTES:-0}" "${KEEP_OTHER_BYTES:-0}" "${TOTAL_BYTES:-0}" "$PE_RATIO" "${DROP_BYTES:-0}")"
      # The window count belongs in this line. PE_PSNR is the worst of the
      # windows, so a prediction drawn from one surviving window is a much
      # weaker claim than the same numbers drawn from three, and nothing else
      # in the output would tell you which you were looking at.
      say "$(basename "$f"): probe ratio ${PE_RATIO}, PSNR ${PE_PSNR:-?} dB, SSIM ${PE_SSIM:-?}, predicted saving ${PLAN_SAVE}% (from ${PE_PROBES:-?} probe window(s))"
      # A quality floor is worth more than a size floor. An encode that passes
      # every structural check and still looks like mush is the failure the
      # exit status cannot see.
      if [[ -n "${PE_PSNR:-}" ]] && ! python3 -c \
        'import sys;sys.exit(0 if float(sys.argv[1])>=float(sys.argv[2]) else 1)' \
        "$PE_PSNR" "$MINPSNR"; then
        warn "$(basename "$f"): probe PSNR ${PE_PSNR} dB is below the ${MINPSNR} dB
      floor, so it is not re-encoded. Either the source is already tightly
      encoded or the settings are wrong for this kind of content. Run
      --calibrate on it before overriding."
        D_ACTION="strip"; D_REASON="below-psnr-floor"
      else
        # Compare the encode against the remux, not against doing nothing.
        # Dropping tracks is lossless, takes a minute, and is available whether
        # or not the video is touched. So the question a re-encode has to
        # answer is what it adds on top of that, and on a grain-heavy title
        # that can be a few points for hours of work on a 56 GB file. Judging
        # it on total saving credits the encode with bytes the remux was going
        # to reclaim anyway.
        STRIP_SAVE="$(python3 -c '
import sys
d=int(sys.argv[1]); t=int(sys.argv[2])
print("%.1f" % (100.0*d/t) if t else "0.0")' "$DROP_BYTES" "$TOTAL_BYTES")"
        ENC_GAIN="$(python3 -c '
import sys
print("%.1f" % (float(sys.argv[1]) - float(sys.argv[2])))' "$PLAN_SAVE" "$STRIP_SAVE")"
        if ! python3 -c 'import sys;sys.exit(0 if float(sys.argv[1])>=float(sys.argv[2]) else 1)' \
             "$ENC_GAIN" "$MINSAVING"; then
          say "$(basename "$f"): re-encoding adds ${ENC_GAIN}% over the ${STRIP_SAVE}% the
      remux gets for free, which is under ${MINSAVING}%. Not re-encoding."
          D_ACTION="strip"; D_REASON="marginal-over-remux"
        fi
      fi
    else
      warn "$(basename "$f"): could not probe, skipping"
      D_ACTION="skip"; D_REASON="probe-failed"
      return 0
    fi
  fi

  # Track dropping is a remux. It costs seconds and often saves more than the
  # re-encode does, so it must not be gated behind the encode decision: a file
  # that is already HEVC can still be carrying half a gigabyte of Spanish DTS.
  if [[ "$D_ACTION" == "strip" ]]; then
    if strip_worth_it; then
      PLAN_PRED="$(python3 -c 'import sys;print("%.0f"%((int(sys.argv[1])-int(sys.argv[2]))/1048576))' \
        "${TOTAL_BYTES:-0}" "${DROP_BYTES:-0}")"
      PLAN_SAVE="$(python3 -c 'import sys;print("%.1f"%(100.0*int(sys.argv[2])/int(sys.argv[1])))' \
        "${TOTAL_BYTES:-1}" "${DROP_BYTES:-0}")"
      say "$(basename "$f"): remux only ($D_REASON), dropping tracks saves ${PLAN_SAVE}%"
    else
      D_ACTION="skip"
      say "$(basename "$f"): nothing worth doing ($D_REASON)"
    fi
  fi
  return 0
}

# ---------------------------- interactive -----------------------------------
confirm_tracks() {  # $1 = file
  [[ -t 0 ]] || return 0
  printf '\n%s\n' "$(basename "$1")" >&2
  cat "$P_TABLE" >&2
  printf '\nkeep audio [%s] subs [%s]\n' "$PLAN_AUDIO" "$PLAN_SUBS" >&2
  local a s
  read -r -p "audio IDs (enter to accept, 'all', 'none'): " a </dev/tty || true
  read -r -p "subtitle IDs: " s </dev/tty || true
  [[ -n "$a" ]] && PLAN_AUDIO="$a"
  [[ -n "$s" ]] && PLAN_SUBS="$s"
  [[ "$PLAN_AUDIO" == "all" ]] && PLAN_AUDIO="${AUDIO_ALL}"
  [[ "$PLAN_SUBS" == "all" ]] && PLAN_SUBS="${SUBS_ALL}"
  return 0
}

# ---------------------------- calibrate -------------------------------------
do_calibrate() {
  local f="$1"
  [[ -f "$f" ]] || die "no such file: $f"
  probe_file "$f"
  [[ "$P_OK" == "1" ]] || die "${P_ERR:-could not read $f}"
  local work="${TMPROOT:-$(dirname "$f")}"
  mkdir -p "$work"
  local at="$CALIBRATE_AT"
  if [[ -z "$at" ]]; then
    at="$(python3 -c '
import sys
t = float(sys.argv[1]) * 0.40
h = int(t // 3600); m = int((t % 3600) // 60); s = t - h * 3600 - m * 60
print("%02d:%02d:%06.3f" % (h, m, s))' "$DURATION")"
  fi
  local endt
  endt="$(python3 -c '
import sys
def sec(x):
    p = [float(y) for y in x.split(":")]
    while len(p) < 3: p.insert(0, 0.0)
    return p[0]*3600 + p[1]*60 + p[2]
t = sec(sys.argv[1]) + float(sys.argv[2])
h = int(t // 3600); m = int((t % 3600) // 60); s = t - h*3600 - m*60
print("%02d:%02d:%06.3f" % (h, m, s))' "$at" "$CALIBRATE_LEN")"

  # Banding and crushed blacks live in dark scenes, and the midpoint of a film
  # is usually not one. Sample the luma average at intervals and take the
  # darkest, so the clip is cut where the encoder is most likely to fail.
  if [[ -z "$CALIBRATE_AT" && $DARKEST -eq 1 ]]; then
    say "Looking for the darkest point in the film"
    local darkat
    darkat="$(find_darkest "$f")"
    if [[ -n "$darkat" ]]; then
      at="$(python3 -c '
import sys
t = float(sys.argv[1])
h, m = int(t // 3600), int((t % 3600) // 60)
print("%02d:%02d:%06.3f" % (h, m, t - h * 3600 - m * 60))' "$darkat")"
      endt="$(python3 -c '
import sys
t = float(sys.argv[1]) + float(sys.argv[2])
h, m = int(t // 3600), int((t % 3600) // 60)
print("%02d:%02d:%06.3f" % (h, m, t - h * 3600 - m * 60))' "$darkat" "$CALIBRATE_LEN")"
    fi
  fi

  local clip="$work/calib.src.mkv"
  # Cut once, and encode that. A seek option on the full source snaps to a
  # keyframe, so two runs can start on different frames and still produce a
  # confident looking PSNR.
  say "Cutting a ${CALIBRATE_LEN}s clip at $at"
  mkvmerge -q -o "$clip" --no-audio --no-subtitles --no-chapters \
    --no-global-tags --no-track-tags --split "parts:${at}-${endt}" "$f" >/dev/null
  [[ -s "$clip" ]] || die "could not cut a clip from $f"

  local srcsize; srcsize="$(filesize "$clip")"
  printf '\n%s\n' "  Source clip: $(python3 -c 'import sys;print("%.1f MB"%(int(sys.argv[1])/1048576))' "$srcsize"), ${VID_W}x${VID_H}, ${VID_PIX:-?}, ${VID_CODEC}"
  printf '  %s\n\n' "Each row is measured against that clip, which is the only thing a shrink must not drift from."
  printf '  %-26s %10s %8s %9s %8s %8s\n' "encode" "size" "of src" "PSNR" "SSIM" "time"

  local saveenc="$ENCODER" saveq="$VTQUALITY" savecrf="$CRF"
  local spec
  for spec in "vt:55" "vt:62" "vt:65" "vt:70" "x265:20" "x265:18"; do
    local kind="${spec%%:*}" val="${spec##*:}"
    ENCODER="$kind"
    [[ "$kind" == "vt" ]] && VTQUALITY="$val" || CRF="$val"
    local dst="$work/calib.${kind}${val}.mkv"
    local t0; t0=$(date +%s)
    if ! encode_video "$clip" "$dst" >/dev/null 2>&1; then
      printf '  %-26s %10s\n' "$kind $val" "failed"
      continue
    fi
    local el=$(( $(date +%s) - t0 ))
    local sz psnr ssim
    sz="$(filesize "$dst")"
    psnr="$(ffmpeg -hide_banner -nostdin -i "$clip" -i "$dst" -lavfi "[0:v]setpts=N[a];[1:v]setpts=N[b];[a][b]psnr" -f null - 2>&1 \
      | grep -o 'average:[0-9.]*' | tail -1 | cut -d: -f2 || true)"
    ssim="$(ffmpeg -hide_banner -nostdin -i "$clip" -i "$dst" -lavfi "[0:v]setpts=N[a];[1:v]setpts=N[b];[a][b]ssim" -f null - 2>&1 \
      | grep -o 'All:[0-9.]*' | tail -1 | cut -d: -f2 || true)"
    printf '  %-26s %9.1fM %7.0f%% %8s %8s %5dm%02ds\n' \
      "$kind $val $([[ $TENBIT -eq 1 ]] && echo 10-bit || echo 8-bit)" \
      "$(python3 -c 'import sys;print(int(sys.argv[1])/1048576)' "$sz")" \
      "$(python3 -c 'import sys;print(100.0*int(sys.argv[1])/int(sys.argv[2]))' "$sz" "$srcsize")" \
      "${psnr:-?}" "${ssim:-?}" "$((el/60))" "$((el%60))"
    [[ $KEEPCLIPS -eq 1 ]] || rm -f "$dst"
  done
  ENCODER="$saveenc"; VTQUALITY="$saveq"; CRF="$savecrf"
  if [[ $KEEPCLIPS -eq 1 ]]; then
    say "Clips kept in $work"
    say "Compare them by eye. PSNR and SSIM rank these rows, but neither sees
      banding or crushed blacks: the error is small in magnitude and spread
      across a large flat area, which is exactly what those metrics average
      away. A row can win the table and still look wrong on a dark scene."
  else
    rm -f "$clip"
  fi

  cat >&2 <<'EOF'

  Reading this: pick the cheapest row whose PSNR you are happy with, then set
  --min-psnr a little below it. Note that this source has already been through
  one lossy encode, so the numbers are second generation and will sit lower
  than anything measured from a near-lossless master. That is expected. What
  matters is where the curve flattens: above that point you are spending bits
  preserving the previous encoder's artefacts.
EOF
}

# Echoes the start time, in seconds, of the darkest sampled point. Uses
# signalstats on one frame per sample so it costs a seek and a decode rather
# than a pass over the film.
find_darkest() {
  local f="$1" dur="${DURATION:-0}" i pts best="" bestval=""
  [[ "${dur%.*}" -gt 120 ]] || { echo ""; return 0; }
  for i in 10 18 26 34 42 50 58 66 74 82 90; do
    pts="$(python3 -c 'import sys;print("%.3f" % (float(sys.argv[1]) * int(sys.argv[2]) / 100.0))' "$dur" "$i")"
    local y
    y="$(ffmpeg -hide_banner -nostdin -ss "$pts" -i "$f" -frames:v 1 \
         -vf signalstats,metadata=print:key=lavfi.signalstats.YAVG \
         -f null - 2>&1 | grep -o 'YAVG=[0-9.]*' | tail -1 | cut -d= -f2 || true)"
    [[ -n "$y" ]] || continue
    if [[ -z "$bestval" ]] || python3 -c 'import sys;sys.exit(0 if float(sys.argv[1])<float(sys.argv[2]) else 1)' "$y" "$bestval"; then
      bestval="$y"; best="$pts"
    fi
  done
  echo "$best"
}

# ---------------------------- plan file -------------------------------------
write_plan() {
  local out="$1"; shift
  collect_inputs "$@"
  [[ ${#FILES[@]} -gt 0 ]] || die "nothing to do"
  banner "${#FILES[@]} file(s) to plan"
  say "Planning ${#FILES[@]} file(s). This probes and test-encodes each one."
  {
    printf '# mkvshrink %s build %s plan, %s\n' "$VERSION" "$BUILD" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '# settings: %s\n' "$(plan_settings_line)"
    printf '#\n'
    printf '# Edit the action, audio and subs columns. Delete rows you do not want.\n'
    printf '# action: shrink | strip | skip\n'
    printf '# audio/subs: comma separated mkvmerge track IDs, or all, or none\n'
    printf '# Sort by save%% to find the rows the rules got wrong: they cluster.\n'
    printf '#\n'
    printf '#action\taudio\tsubs\tsave%%\tpsnr\tsize_mb\tpred_mb\tuid\tpath\treason\n'
  } > "$out"
  local f
  for f in "${FILES[@]}"; do
    analyse "$f"
    plan_row "$f" >> "$out"
  done
  say "Wrote $out"
  say "Read it, fix what needs fixing, then: mkvshrink --apply $out"
}

banner() {
  say "mkvshrink $VERSION build $BUILD${1:+, $1}, $(plan_settings_line)"
}

plan_settings_line() {
  local s
  if [[ "$ENCODER" == "vt" ]]; then s="vt q$VTQUALITY"; else s="x265 crf$CRF $PRESET"; fi
  [[ $TENBIT -eq 1 ]] && s="$s 10bit"
  echo "$s min-saving=${MINSAVING}% min-psnr=${MINPSNR}dB min-size=$(human_size "$MINSIZE") audio=$AUDIOLANGS subs=$SUBLANGS replace=$REPLACE"
}

apply_plan() {
  local plan="$1"
  [[ -f "$plan" ]] || die "no such plan: $plan"
  banner "applying $(basename "$plan")"
  # The plan records the build that wrote it. If that is not this build, say
  # so: the rules and the arithmetic have both changed between builds, and a
  # plan generated under different logic is worth re-checking.
  local planbuild
  planbuild="$(sed -n 's/^# mkvshrink \([^ ]*\) build \([^ ]*\) plan.*/\1 build \2/p' "$plan" | head -1)"
  if [[ -n "$planbuild" && "$planbuild" != "$VERSION build $BUILD" ]]; then
    warn "this plan was written by mkvshrink $planbuild and you are running
      $VERSION build $BUILD. Predictions and track rules may have changed.
      Re-run --plan if the numbers matter."
  fi
  local n=0 done=0 failed=0 skipped=0
  local action akeep skeep save psnr size pred uid path reason
  # save, size, pred and reason are read for their column position only. The file is
  # re-probed here rather than trusted, because the plan may be old.
  # shellcheck disable=SC2034
  while IFS=$'\t' read -r action akeep skeep save psnr size pred uid path reason; do
    [[ -z "$action" || "$action" == \#* ]] && continue
    n=$((n + 1))
    [[ "$action" == "skip" ]] && { skipped=$((skipped + 1)); continue; }
    if [[ ! -f "$path" ]]; then
      warn "gone since the plan was written: $path"
      failed=$((failed + 1)); continue
    fi
    probe_file "$path"
    if [[ "$P_OK" != "1" ]]; then
      warn "cannot read $path: ${P_ERR:-}"; failed=$((failed + 1)); continue
    fi
    # A plan goes stale the moment anything else touches the library, and track
    # IDs shift once a file has been processed. Applying a stale row keeps the
    # wrong tracks and says nothing about it, so the file has to prove it is
    # still the file the plan was written about. Path alone does not.
    if [[ -n "$uid" && -n "${SEGUID:-}" && "$uid" != "$SEGUID" ]]; then
      warn "$path has changed since the plan was written, so it is left alone.
      Re-run --plan for it."
      failed=$((failed + 1)); continue
    fi
    [[ "$akeep" == "all" ]] && akeep="${AUDIO_ALL}"
    [[ "$skeep" == "all" ]] && skeep="${SUBS_ALL}"
    [[ "$akeep" == "-" ]] && akeep="${AUDIO_KEEP}"
    [[ "$skeep" == "-" ]] && skeep="${SUBS_KEEP}"
    # Provenance that is worth having: six months from now, a file with one
    # audio track and no obvious reason for it should say whether that was the
    # rules or a decision somebody made.
    local tracksrc="rules"
    [[ "$akeep" == "${AUDIO_KEEP}" && "$skeep" == "${SUBS_KEEP}" ]] || tracksrc="manual"
    if shrink_one "$path" "$action" "$akeep" "$skeep" "$tracksrc"; then
      done=$((done + 1))
    else
      failed=$((failed + 1))
    fi
  done < "$plan"
  say "Plan finished: $done done, $skipped skipped, $failed failed, of $n rows"
}

# ---------------------------- main ------------------------------------------
if [[ -n "$CALIBRATE" ]]; then
  do_calibrate "$CALIBRATE"
  exit 0
fi

if [[ -n "$APPLYIN" ]]; then
  apply_plan "$APPLYIN"
  exit 0
fi

if [[ -n "$PLANOUT" ]]; then
  [[ ${#INPUTS[@]} -gt 0 ]] || { usage >&2; die "no input files or folders given"; }
  write_plan "$PLANOUT" "${INPUTS[@]}"
  exit 0
fi

[[ ${#INPUTS[@]} -gt 0 ]] || { usage >&2; die "no input files or folders given"; }
collect_inputs "${INPUTS[@]}"
[[ ${#FILES[@]} -gt 0 ]] || die "nothing to do"

banner "${#FILES[@]} file(s)"
if [[ ${#FILES[@]} -gt 8 && -z "$PLANOUT" && $INTERACTIVE -eq 0 ]]; then
  say "That is a sweep. Consider --plan so you can read the decisions before
      committing hours to them."
fi

TOTAL_DONE=0; TOTAL_FAILED=0; TOTAL_SKIPPED=0
SWEEP_T0=$(date +%s)
SWEEP_BYTES_DONE=0
SWEEP_BYTES_TODO=0
for _f in "${FILES[@]}"; do
  SWEEP_BYTES_TODO=$(( SWEEP_BYTES_TODO + $(filesize "$_f") ))
done
SWEEP_INDEX=0

for f in "${FILES[@]}"; do
  SWEEP_INDEX=$(( SWEEP_INDEX + 1 ))
  analyse "$f"
  if [[ -n "$ATRACKS" ]]; then
    PLAN_AUDIO="$ATRACKS"
    [[ "$PLAN_AUDIO" == "all" ]] && PLAN_AUDIO="${AUDIO_ALL}"
  fi
  if [[ -n "$STRACKS" ]]; then
    PLAN_SUBS="$STRACKS"
    [[ "$PLAN_SUBS" == "all" ]] && PLAN_SUBS="${SUBS_ALL}"
  fi
  [[ $INTERACTIVE -eq 1 ]] && confirm_tracks "$f"
  rm -f "${P_TABLE:-}"
  if [[ "$D_ACTION" == "skip" ]]; then
    TOTAL_SKIPPED=$((TOTAL_SKIPPED + 1))
    SWEEP_BYTES_TODO=$(( SWEEP_BYTES_TODO - $(filesize "$f") ))
    continue
  fi
  TRACKSRC="rules"
  [[ "$PLAN_AUDIO" == "${AUDIO_KEEP}" && "$PLAN_SUBS" == "${SUBS_KEEP}" ]] || TRACKSRC="manual"
  _sz=$(filesize "$f")
  if shrink_one "$f" "$D_ACTION" "$PLAN_AUDIO" "$PLAN_SUBS" "$TRACKSRC"; then
    TOTAL_DONE=$((TOTAL_DONE + 1))
  else
    TOTAL_FAILED=$((TOTAL_FAILED + 1))
  fi
  SWEEP_BYTES_DONE=$(( SWEEP_BYTES_DONE + _sz ))
  SWEEP_BYTES_TODO=$(( SWEEP_BYTES_TODO - _sz ))
  sweep_progress "$SWEEP_INDEX" "${#FILES[@]}"
done

say "Done: $TOTAL_DONE processed, $TOTAL_SKIPPED skipped, $TOTAL_FAILED failed"
mach "@@summary $TOTAL_DONE $TOTAL_SKIPPED $TOTAL_FAILED"
