#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Alan Wild
# ---------------------------------------------------------------------------
# mkvshrink - re-encode H.264 MKV files to HEVC to reclaim disk, and drop the
#             audio and subtitle tracks you will never play.
#
# Pipeline, per file:
#   1. mkvmerge -J   read tracks, flags, languages, stereo mode, display size
#   2. mkvmerge      cut a few short sample windows, video only
#   3. ffmpeg        encode the samples, measure size ratio and PSNR
#   4. ffmpeg        encode the full video track to a staging file
#   5. mkvmerge      build the file you keep: new video, chosen tracks from the
#                    source, chapters carried across, provenance tags
#   6. mkvpropedit   restore StereoMode and display dimensions
#   7. verify        length, startup, Cues, chapters, stereo, then and only then
#                    is the original touched
#
# Audio and subtitles are never re-encoded and never pass through FFmpeg. They
# go straight from the source into the output via mkvmerge.
# ---------------------------------------------------------------------------
set -euo pipefail

VERSION="3.26"
# Increments on every build handed over, including ones that never reach a
# release. VERSION alone answers "which release", and during a week of
# iteration that is eight different scripts all claiming 3.26. BUILD is what
# tells you which of them wrote a given file, and it is stamped into the
# output for exactly that reason.
BUILD="18"

# ------------------------------- defaults ----------------------------------
ENCODER=vt            # vt | x265
VTQUALITY=62
CRF=20
PRESET=slow
TENBIT=1
MINSAVING=10          # percent
MINSIZE=5368709120    # 5 GB. Below this there is no meaningful disk to reclaim.
MINPSNR=40            # dB, probe encode against the source samples
REPLACE=folder        # folder | insitu | none
REPLACEDIR=""         # empty means a _replaced folder beside each file
RECURSE=1
SKIPHEVC=1
ALLOWHDR=0
ALLOWINTERLACED=0
SUBLANGS="eng,en,und"
AUDIOLANGS="eng,en"
KEEPCOMMENTARY=1
KEEPFORCED=1
NOTRACKS=0            # --keep-all-tracks: do not drop anything
PROBECOUNT=3
PROBELEN=20
PLANOUT=""
APPLYIN=""
CALIBRATE=""
CALIBRATE_AT=""
CALIBRATE_LEN=60
KEEPCLIPS=0
DARKEST=1
INTERACTIVE=0
ATRACKS=""
STRACKS=""
TMPROOT=""
DRYRUN=0
MACHINE=0
FORCE=0
VERIFY_FULL=0
SETPARAMS=""
SP_PRIM=bt709; SP_TRC=bt709; SP_SPC=bt709; SP_RANGE=tv
PE_RATIO=""; PE_PSNR=""; PE_SSIM=""; PE_PROBES=0
PROGRESS_DUR=""; PROGRESS_NAME=""
STRIP_SAVE="0.0"; ENC_GAIN="0.0"

usage() {
  cat <<EOF
mkvshrink $VERSION

  mkvshrink [options] PATH...            shrink files or folders now
  mkvshrink --plan FILE PATH...          write a plan, change nothing
  mkvshrink --apply FILE                 carry out an edited plan
  mkvshrink --calibrate FILE             measure settings on your own footage

What it does
  Re-encodes the video track to HEVC and drops the audio and subtitle tracks
  the rules below decide you will never play. Both parts are independent: a
  file that is already HEVC, or that would barely shrink, can still be worth
  rewriting for the tracks alone.

  Nothing is destroyed until the output has passed every check.

Options
      --plan FILE       probe everything, write a plan file, exit. This is the
                        way to sweep a library: read the decisions as a table,
                        fix the handful the rules got wrong, then --apply.
      --apply FILE      carry out a plan file
      --calibrate FILE  encode one clip at several settings against the source
                        and print size, PSNR, SSIM and time. Do this once per
                        kind of content before sweeping. The defaults were
                        measured on 3840x1080 3D and do not transfer.
      --calibrate-at T  where to cut the calibration clip (default: 40% in)
      --calibrate-len N seconds of calibration clip (default $CALIBRATE_LEN)
      --no-darkest      cut the calibration clip at the midpoint rather than
                        hunting for the darkest scene. Dark scenes are where
                        banding and crushed blacks show, so that is where the
                        clip is taken from by default.
      --keep-clips      keep the calibration clips instead of deleting them, so
                        the encodes can be compared by eye. PSNR and SSIM do not
                        see banding or black crush; looking at the file does.

  Encoding
      --x265            libx265 instead of VideoToolbox. About 8% smaller and
                        about 25 times slower.
      --vt-quality N    VideoToolbox quality 1-100 (default $VTQUALITY). Not a
                        CRF: higher is better.
  -q, --crf N           x265 CRF (default $CRF)
  -p, --preset P        x265 preset (default $PRESET)
      --8bit            encode 8-bit. 10-bit is the default and costs nothing.

  What to skip
      --min-saving PCT  skip the re-encode when the predicted saving is under
                        this (default $MINSAVING). Measured with a probe encode,
                        not guessed from bitrate.
      --min-psnr DB     reject an encode whose probe PSNR against the source is
                        below this (default $MINPSNR). Calibrate this. The
                        default is a starting point, not a measurement.
      --min-size SIZE   skip files smaller than this outright, before probing
                        (default 5G). Accepts 5G, 500M, 1.5T; a bare number is
                        gigabytes. A small file is small because it was already
                        encoded at a low bitrate, so the encode inflates it and
                        it gets rejected anyway, after three probe encodes have
                        been spent finding that out.
      --no-min-size     probe every file however small
      --no-skip-hevc    re-encode files that are already HEVC
      --allow-hdr       do not skip HDR files. Read the warning first.
      --allow-interlaced  do not skip interlaced files
      --force           ignore every skip rule

  Tracks
      --audio-langs L   audio languages to keep (default $AUDIOLANGS). The first
                        audio track is always kept whatever its language, which
                        is what makes this work on foreign films.
      --sub-langs L     subtitle languages to keep (default $SUBLANGS)
      --no-commentary   drop commentary tracks (kept by default: they are not
                        recoverable)
      --no-forced       drop forced subtitles that fail the language filter.
                        Forced subs carry the alien dialogue in an English
                        film, so this loses lines nothing else covers.
      --keep-all-tracks do not drop anything
      --audio LIST      explicit mkvmerge track IDs, one input file only
      --subs LIST       same for subtitles. "none" is allowed.
  -i, --interactive     show the track table and confirm, per file

  Originals
      --in-situ         replace the original in place once checks pass
      --keep-originals  write beside the original and touch nothing
      --replaced-dir D  put replaced originals under D, mirroring their path
                        (default: a _replaced folder beside each file)

  Other
      --no-recurse      do not descend into subfolders
      --temp DIR        scratch directory (default: beside the output)
      --verify-quality  measure PSNR over the whole file after encoding, not
                        just the probe. Roughly doubles the time.
      --machine         emit machine-readable @@ lines on stdout
  -n, --dry-run         print what would happen and exit
  -V, --version         print the version and exit
  -h, --help            this text

Examples
  mkvshrink --calibrate /Volumes/Media/Film.mkv
  mkvshrink --plan sweep.tsv /Volumes/Media/Films
  \$EDITOR sweep.tsv
  mkvshrink --apply sweep.tsv
  mkvshrink --audio 1 --subs 4 Film.mkv
EOF
}

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; mach "@@warn $*"; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; mach "@@error $*"; exit 1; }
# Machine-readable status for GUI front ends. Human text always goes to stderr,
# so stdout carries nothing but @@ lines and stays trivially parseable.
mach() { if [[ ${MACHINE:-0} -eq 1 ]]; then printf '%s\n' "${*//$'\n'/ }"; fi; }

# "12", "12G", "500M", "1.5T". Bare numbers are gigabytes, because nobody
# passes --min-size in bytes and silently reading 5 as five bytes would make
# the gate do nothing at all.
# Bytes back to something readable, so the banner and the plan header do not
# say "min-size=0.00977G".
human_size() {
  python3 -c '
import sys
n = int(sys.argv[1])
if n <= 0:
    print("off"); raise SystemExit
for unit, mult in (("T", 1024**4), ("G", 1024**3), ("M", 1024**2), ("K", 1024)):
    if n >= mult:
        v = n / mult
        print(("%d%s" % (v, unit)) if abs(v - round(v)) < 0.05 else ("%.1f%s" % (v, unit)))
        raise SystemExit
print("%dB" % n)
' "$1"
}

parse_size() {
  python3 -c '
import re, sys
s = sys.argv[1].strip().upper()
m = re.match(r"^([0-9]*\.?[0-9]+)\s*([KMGT]?)B?$", s)
if not m:
    sys.stderr.write("not a size: %s\n" % sys.argv[1]); sys.exit(1)
n = float(m.group(1))
mult = {"": 1024**3, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
print(int(n * mult[m.group(2)]))
' "$1" || die "--min-size wants something like 5G, 500M or 1.5T"
}

# ------------------------------- args --------------------------------------
INPUTS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --plan)            PLANOUT="$2"
                       # "--plan /Volumes/video/Anime" reads as a plan named
                       # after the folder you meant to scan, and then there are
                       # no inputs left. Catch it here rather than printing
                       # usage into the file the redirect just created.
                       [[ -d "$PLANOUT" ]] && die "--plan takes the plan filename
      first, then the folders to scan:
        mkvshrink --plan plan.tsv \"$PLANOUT\""
                       case "$PLANOUT" in
                         *.mkv|*.MKV) die "--plan wants a plan filename, not a video file" ;;
                       esac
                       shift 2 ;;
    --apply)           APPLYIN="$2"; shift 2 ;;
    --calibrate)       CALIBRATE="$2"; shift 2 ;;
    --calibrate-at)    CALIBRATE_AT="$2"; shift 2 ;;
    --calibrate-len)   CALIBRATE_LEN="$2"; shift 2 ;;
    --keep-clips)      KEEPCLIPS=1; shift ;;
    --no-darkest)      DARKEST=0; shift ;;
    --x265)            ENCODER=x265; shift ;;
    --vt-quality)      VTQUALITY="$2"; shift 2 ;;
    -q|--crf)          CRF="$2"; shift 2 ;;
    -p|--preset)       PRESET="$2"; shift 2 ;;
    --8bit)            TENBIT=0; shift ;;
    --min-saving)      MINSAVING="$2"; shift 2 ;;
    --min-size)        MINSIZE="$(parse_size "$2")"; shift 2 ;;
    --no-min-size)     MINSIZE=0; shift ;;
    --min-psnr)        MINPSNR="$2"; shift 2 ;;
    --probes)          PROBECOUNT="$2"; shift 2 ;;
    --probe-len)       PROBELEN="$2"; shift 2 ;;
    --no-probe)        PROBECOUNT=0; shift ;;
    --no-skip-hevc)    SKIPHEVC=0; shift ;;
    --allow-hdr)       ALLOWHDR=1; shift ;;
    --allow-interlaced) ALLOWINTERLACED=1; shift ;;
    --force)           FORCE=1; shift ;;
    --audio-langs)     AUDIOLANGS="$2"; shift 2 ;;
    --sub-langs)       SUBLANGS="$2"; shift 2 ;;
    --no-commentary)   KEEPCOMMENTARY=0; shift ;;
    --no-forced)       KEEPFORCED=0; shift ;;
    --keep-all-tracks) NOTRACKS=1; shift ;;
    --audio)           ATRACKS="$2"; shift 2 ;;
    --subs)            STRACKS="$2"; shift 2 ;;
    -i|--interactive)  INTERACTIVE=1; shift ;;
    --in-situ|--in-place) REPLACE=insitu; shift ;;
    --keep-originals)  REPLACE=none; shift ;;
    --replaced-dir)    REPLACEDIR="$2"; shift 2 ;;
    --no-recurse)      RECURSE=0; shift ;;
    --temp)            TMPROOT="$2"; shift 2 ;;
    --verify-quality)  VERIFY_FULL=1; shift ;;
    --machine)         MACHINE=1; shift ;;
    -n|--dry-run)      DRYRUN=1; shift ;;
    -h|--help)         usage; exit 0 ;;
    -V|--version)      echo "mkvshrink $VERSION build $BUILD"; exit 0 ;;
    -*)                die "unknown option: $1" ;;
    *)                 INPUTS+=("$1"); shift ;;
  esac
done

case "$ENCODER" in vt|x265) ;; *) die "bad encoder: $ENCODER" ;; esac
[[ "$MINSAVING" =~ ^[0-9]+$ ]] || die "--min-saving takes a whole number of percent"

# Explicit track IDs mean nothing across files. Silently applying "--audio 1,3"
# to a folder would keep an arbitrary track in every one of them.
if [[ -n "$ATRACKS" || -n "$STRACKS" ]]; then
  [[ ${#INPUTS[@]} -eq 1 ]] || die "--audio and --subs take one input file.
      Track IDs are per file. For a sweep use --plan, edit the table, --apply."
  [[ -f "${INPUTS[0]}" ]] || die "--audio and --subs take a file, not a folder"
fi

# ------------------------------- tools -------------------------------------
need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH.
      brew install ffmpeg mkvtoolnix"; }
need ffmpeg; need ffprobe; need mkvmerge; need mkvextract; need mkvpropedit
need python3

mach "@@version $VERSION"

# ---------------------------- probe helper ---------------------------------
# One Python pass over mkvmerge -J and ffprobe -show_streams, because the two
# tools each know things the other does not. mkvmerge has the track IDs the
# muxer will use, the flags, the stereo mode and the display dimensions.
# ffprobe has the pixel format, the colour tags, the field order and the
# NUMBER_OF_BYTES statistics tags that say what each track actually costs.
read -r -d '' PROBE_PY <<'PROBEPY' || true
import json, shlex, sys

mkv_path, ff_path, table_path = sys.argv[1], sys.argv[2], sys.argv[3]
sub_langs = [x.strip().lower() for x in sys.argv[4].split(",") if x.strip()]
aud_langs = [x.strip().lower() for x in sys.argv[5].split(",") if x.strip()]
keep_comm = sys.argv[6] == "1"
keep_forced = sys.argv[7] == "1"
keep_all = sys.argv[8] == "1"

out = {}


def emit():
    for k, v in out.items():
        print("%s=%s" % (k, shlex.quote(str(v))))


try:
    mk = json.load(open(mkv_path, encoding="utf-8"))
except Exception as e:
    out["OK"] = 0
    out["ERR"] = "mkvmerge could not read the file: %s" % e
    emit()
    sys.exit(0)

try:
    ff = json.load(open(ff_path, encoding="utf-8"))
except Exception:
    ff = {"streams": [], "format": {}}

mk_tracks = mk.get("tracks", [])
ff_streams = ff.get("streams", [])


def norm(t):
    return {"subtitle": "subtitles"}.get(t, t)


# Both tools list tracks in file order, so position n means the same track in
# each. That is an assumption, so check it rather than trust it: if the type
# sequences disagree the byte figures are matched to the wrong tracks and every
# prediction downstream is quietly wrong.
mk_types = [t.get("type") for t in mk_tracks]
ff_types = [norm(s.get("codec_type")) for s in ff_streams
            if norm(s.get("codec_type")) in ("video", "audio", "subtitles")]
aligned = mk_types == ff_types
ff_by_pos = {}
if aligned:
    n = 0
    for s in ff_streams:
        if norm(s.get("codec_type")) in ("video", "audio", "subtitles"):
            ff_by_pos[n] = s
            n += 1

fmt = ff.get("format", {})
try:
    duration = float(fmt.get("duration", 0))
except Exception:
    duration = 0.0
try:
    total_bytes = int(fmt.get("size", 0))
except Exception:
    total_bytes = 0


def stream_bytes(s, dur):
    """What this track costs, from the statistics tags if the file has them."""
    if not s:
        return 0
    tags = {k.lower(): v for k, v in (s.get("tags") or {}).items()}
    for k, v in tags.items():
        if k.startswith("number_of_bytes"):
            try:
                return int(v)
            except Exception:
                pass
    # MakeMKV and mkvmerge both write those tags, so most of a library will
    # just answer. Falling back to bitrate is a guess and is flagged as one.
    br = s.get("bit_rate") or tags.get("bps") or tags.get("bps-eng")
    try:
        if br and dur > 0:
            return int(float(br) * dur / 8.0)
    except Exception:
        pass
    return 0


video = None
audio = []
subs = []
for pos, t in enumerate(mk_tracks):
    p = t.get("properties", {}) or {}
    s = ff_by_pos.get(pos)
    rec = {
        "pos": pos,
        "id": t.get("id"),
        "type": t.get("type"),
        "codec_id": p.get("codec_id", "") or "",
        "codec": t.get("codec", "") or "",
        "lang": (p.get("language") or "und").lower(),
        "name": p.get("track_name", "") or "",
        "default": 1 if p.get("default_track") else 0,
        "forced": 1 if p.get("forced_track") else 0,
        "commentary": 1 if p.get("flag_commentary") else 0,
        "hi": 1 if p.get("flag_hearing_impaired") else 0,
        "channels": p.get("audio_channels", "") or "",
        "bytes": stream_bytes(s, duration),
        "est": 0 if (s and any(k.lower().startswith("number_of_bytes")
                               for k in (s.get("tags") or {}))) else 1,
    }
    if t.get("type") == "video":
        rec["pix"] = (s or {}).get("pix_fmt", "") or ""
        rec["w"] = p.get("pixel_dimensions", "0x0").split("x")[0]
        rec["h"] = p.get("pixel_dimensions", "0x0").split("x")[-1]
        rec["stereo"] = p.get("stereo_mode", 0) or 0
        rec["disp"] = p.get("display_dimensions", "") or ""
        rec["trc"] = (s or {}).get("color_transfer", "") or ""
        rec["prim"] = (s or {}).get("color_primaries", "") or ""
        rec["spc"] = (s or {}).get("color_space", "") or ""
        rec["range"] = (s or {}).get("color_range", "") or ""
        rec["field"] = (s or {}).get("field_order", "") or ""
        if video is None:
            video = rec
    elif t.get("type") == "audio":
        audio.append(rec)
    elif t.get("type") == "subtitles":
        subs.append(rec)

if video is None:
    out["OK"] = 0
    out["ERR"] = "no video track"
    emit()
    sys.exit(0)


def is_sdh(rec):
    if rec["hi"]:
        return True
    n = rec["name"].lower()
    return any(w in n for w in ("sdh", "hearing", "caption", " cc", "cc "))


def is_commentary(rec):
    if rec["commentary"]:
        return True
    n = rec["name"].lower()
    return "commentary" in n or "director" in n


# --- the rules -------------------------------------------------------------
# Subtitles: language whitelist, plus every forced track whatever its language.
# A forced French track on an English film carries dialogue that no English
# track duplicates, so dropping it loses content rather than duplication.
sub_keep = []
for r in subs:
    why = ""
    if keep_all:
        why = "keep-all"
    elif r["lang"] in sub_langs:
        why = "lang"
    elif keep_forced and r["forced"]:
        why = "forced"
    if why:
        sub_keep.append(r)
    r["why"] = why

# Audio: keep the language whitelist, and always keep the first audio track
# whatever it is. On an English film track 1 is English and the dubs go. On a
# foreign film track 1 is the original language and it stays, along with an
# English dub if the disc carried one. Where this is wrong it keeps a track it
# did not need to, which is the cheap direction to be wrong in.
aud_keep = []
for i, r in enumerate(audio):
    why = ""
    if keep_all:
        why = "keep-all"
    elif i == 0:
        why = "first"
    elif r["lang"] in aud_langs:
        why = "lang"
    elif keep_comm and is_commentary(r):
        why = "commentary"
    if why:
        aud_keep.append(r)
    r["why"] = why

# Any whitelist meets a file tagged in a way nobody anticipated. Losing every
# audio track is a mute film; keeping a few megabytes of Spanish is nothing.
warnings = []
if audio and not aud_keep:
    aud_keep = list(audio)
    for r in audio:
        r["why"] = "fallback"
    warnings.append("no audio track matched the rules, so all were kept")
if subs and not sub_keep:
    sub_keep = list(subs)
    for r in subs:
        r["why"] = "fallback"
    warnings.append("no subtitle track matched the rules, so all were kept")

# --- default flags ---------------------------------------------------------
# Dropping the track that carried the default flag leaves a file with no
# default at all, and players then pick whatever they feel like. Which track
# was default is reported here; whether it survived can only be decided against
# the list of tracks actually kept, which may have been edited by hand since.
def default_id(tracks):
    for r in tracks:
        if r["default"]:
            return str(r["id"])
    return ""


out["OK"] = 1
out["DURATION"] = "%.3f" % duration
out["TOTAL_BYTES"] = total_bytes
out["SEGUID"] = (mk.get("container", {}).get("properties", {}) or {}).get(
    "segment_uid", "")
out["ALIGNED"] = 1 if aligned else 0

out["VID_ID"] = video["id"]
out["VID_CODEC"] = video["codec_id"]
out["VID_W"] = video["w"]
out["VID_H"] = video["h"]
out["VID_PIX"] = video["pix"]
out["VID_LANG"] = video["lang"]
out["VID_NAME"] = video["name"]
out["VID_TRC"] = video["trc"]
out["VID_PRIM"] = video["prim"]
out["VID_SPC"] = video["spc"]
out["VID_RANGE"] = video["range"]
out["VID_BYTES"] = video["bytes"]
out["STEREO"] = video["stereo"]
out["DISP"] = video["disp"]

out["IS_HEVC"] = 1 if "HEVC" in video["codec_id"].upper() or "265" in video[
    "codec_id"] else 0
out["IS_HDR"] = 1 if video["trc"] in ("smpte2084", "arib-std-b67") else 0
out["IS_INTERLACED"] = 0 if video["field"] in ("", "progressive", "unknown") else 1
out["IS_10BIT"] = 1 if "10" in video["pix"] else 0

out["AUDIO_ALL"] = ",".join(str(r["id"]) for r in audio)
out["SUBS_ALL"] = ",".join(str(r["id"]) for r in subs)
out["AUDIO_KEEP"] = ",".join(str(r["id"]) for r in aud_keep)
out["SUBS_KEEP"] = ",".join(str(r["id"]) for r in sub_keep)
out["AUDIO_DEFAULT_ID"] = default_id(audio)
out["SUBS_DEFAULT_ID"] = default_id(subs)

# Which languages lose every one of their tracks. The rule is "whitelist
# languages, plus the first audio track whatever it is", and that covers a
# foreign film only when the original language is listed first. On a release
# that puts the English dub at track 1 and the original at track 4, the
# original is neither whitelisted nor first, and it is silently dropped. The
# plan showed "1" in the audio column and nothing about what went, so there
# was nothing to review. Name the losses instead.
kept_alangs = {r["lang"] for r in aud_keep}
lost_alangs = []
for r in audio:
    if r["lang"] not in kept_alangs and r["lang"] not in lost_alangs:
        lost_alangs.append(r["lang"])
out["AUDIO_LOST_LANGS"] = ",".join(lost_alangs)
out["AUDIO_KEEP_LANGS"] = ",".join(sorted(kept_alangs))

keep_ids = {r["id"] for r in aud_keep} | {r["id"] for r in sub_keep}
drop_bytes = sum(r["bytes"] for r in audio + subs if r["id"] not in keep_ids)
keep_other = sum(r["bytes"] for r in audio + subs if r["id"] in keep_ids)
out["DROP_BYTES"] = drop_bytes
out["KEEP_OTHER_BYTES"] = keep_other
out["EST_BYTES"] = 1 if any(r["est"] for r in [video] + audio + subs) else 0
out["WARNINGS"] = "; ".join(warnings)

# --- the human readable table ----------------------------------------------
lines = []
lines.append("  id  type       codec                 lang  flags        size  keep")
def fmt_size(b):
    if not b:
        return "     ?"
    return "%6.0fM" % (b / 1048576.0)


for r in [video] + audio + subs:
    flags = []
    if r["default"]:
        flags.append("default")
    if r["forced"]:
        flags.append("forced")
    if r["type"] != "video" and is_commentary(r):
        flags.append("comm")
    if r["type"] == "subtitles" and is_sdh(r):
        flags.append("sdh")
    keep = "yes" if r["type"] == "video" else (
        "yes (%s)" % r["why"] if r.get("why") else "NO")
    nm = (" " + r["name"][:28]) if r["name"] else ""
    lines.append("  %-3s %-10s %-21s %-5s %-12s %s  %s%s" % (
        r["id"], r["type"], r["codec"][:21], r["lang"],
        ",".join(flags)[:12], fmt_size(r["bytes"]), keep, nm))
open(table_path, "w", encoding="utf-8").write("\n".join(lines) + "\n")

emit()
PROBEPY

# probe FILE -> sets P_* variables in the caller via eval
probe_file() {
  local f="$1" mkjson ffjson
  mkjson="$(mktemp "${TMPDIR:-/tmp}/mkvshrink.mk.XXXXXX")"
  ffjson="$(mktemp "${TMPDIR:-/tmp}/mkvshrink.ff.XXXXXX")"
  P_TABLE="$(mktemp "${TMPDIR:-/tmp}/mkvshrink.tbl.XXXXXX")"
  mkvmerge -J "$f" > "$mkjson" 2>/dev/null || echo '{}' > "$mkjson"
  ffprobe -v error -show_streams -show_format -of json "$f" > "$ffjson" 2>/dev/null \
    || echo '{}' > "$ffjson"
  local kv
  kv="$(python3 -c "$PROBE_PY" "$mkjson" "$ffjson" "$P_TABLE" \
        "$SUBLANGS" "$AUDIOLANGS" "$KEEPCOMMENTARY" "$KEEPFORCED" "$NOTRACKS")"
  rm -f "$mkjson" "$ffjson"
  OK=0; ERR=""; WARNINGS=""
  eval "$kv"
  P_OK="$OK"; P_ERR="${ERR:-}"
}

# ---------------------------- decision -------------------------------------
# What to do with a file, given everything the probe found. Kept separate from
# doing it, because --plan needs the decision without the work.
decide() {  # sets D_ACTION D_REASON
  D_ACTION="shrink"; D_REASON=""
  if [[ $FORCE -eq 1 ]]; then return 0; fi
  # Cheapest gate first, before three probe encodes are spent finding out that
  # a 2 GB WEB-DL was never a candidate. A small file is small because it was
  # already encoded at a low bitrate, so the ratio comes back above 1 and it
  # gets rejected anyway, having cost probe time on every run.
  if [[ "${MINSIZE:-0}" -gt 0 ]] && \
     [[ "${TOTAL_BYTES:-0}" -lt "$MINSIZE" ]]; then
    D_ACTION="skip"; D_REASON="under-min-size"; return 0
  fi
  if [[ "$IS_HDR" == "1" && $ALLOWHDR -eq 0 ]]; then
    D_ACTION="skip"; D_REASON="hdr"; return 0
  fi
  if [[ "$IS_INTERLACED" == "1" && $ALLOWINTERLACED -eq 0 ]]; then
    D_ACTION="skip"; D_REASON="interlaced"; return 0
  fi
  if [[ "$IS_HEVC" == "1" && $SKIPHEVC -eq 1 ]]; then
    # Already HEVC is not the same as nothing to do. The tracks may still be
    # worth hundreds of megabytes, and that is a remux, not an encode.
    D_ACTION="strip"; D_REASON="already-hevc"; return 0
  fi
  return 0
}

# strip_worth_it: does dropping tracks alone clear the threshold?
strip_worth_it() {
  [[ "${DROP_BYTES:-0}" -gt 0 ]] || return 1
  [[ "${TOTAL_BYTES:-0}" -gt 0 ]] || return 1
  python3 -c 'import sys
d, t, m = int(sys.argv[1]), int(sys.argv[2]), float(sys.argv[3])
sys.exit(0 if t and (100.0 * d / t) >= m else 1)' "$DROP_BYTES" "$TOTAL_BYTES" "$MINSAVING"
}

# ---------------------------- encode command --------------------------------
# Colour is carried across from the source, not asserted.
#
# mvc2sbs writes bt709 unconditionally because its input is untagged Y4M out of
# a decoder. Here the input is a tagged MKV that might be anything, and forcing
# bt709 onto a BT.2020 file would mislabel it permanently. So setparams repeats
# what the source says, which keeps the input and the requested output in
# agreement and stops swscale inserting a full colour round trip through 16-bit
# RGB on every frame. That conversion announces itself as "No accelerated
# colorspace conversion found from yuv420p to bgr48le" and only appears at
# 10-bit, because at 8-bit no scaler is inserted at all. A format= filter does
# not fix it.
build_setparams() {
  local prim="${VID_PRIM:-}" trc="${VID_TRC:-}" spc="${VID_SPC:-}" rng="${VID_RANGE:-}"
  # An untagged Blu-ray source is Rec.709 in practice, which is also what
  # every player assumes, so say so rather than leave it unset.
  [[ -z "$prim" || "$prim" == "unknown" ]] && prim=bt709
  [[ -z "$trc"  || "$trc"  == "unknown" ]] && trc=bt709
  [[ -z "$spc"  || "$spc"  == "unknown" ]] && spc=bt709
  case "$rng" in tv|pc) ;; *) rng=tv ;; esac
  # Set globals rather than echo them. A command substitution runs in a
  # subshell, so anything assigned inside one is gone by the time the caller
  # looks, and the -color_primaries argument built from it is then unset.
  SP_PRIM="$prim"; SP_TRC="$trc"; SP_SPC="$spc"; SP_RANGE="$rng"
  SETPARAMS="setparams=color_primaries=${prim}:color_trc=${trc}:colorspace=${spc}:range=${rng}"
}

pixfmt_for() {
  if [[ $TENBIT -eq 1 ]]; then
    [[ "$ENCODER" == "vt" ]] && echo p010le || echo yuv420p10le
  else
    echo yuv420p
  fi
}

# encode_video SRC DST [EXTRA...]
# No mapfile, no readarray, no ${x,,}: stock macOS still ships bash 3.2 and
# the rest of this repository stays inside it.
encode_video() {
  local src="$1" dst="$2"; shift 2
  build_setparams
  local sp="$SETPARAMS"
  local -a ff enc
  if [[ "$ENCODER" == "vt" ]]; then
    enc=(-c:v hevc_videotoolbox -q:v "$VTQUALITY" -tag:v hvc1)
  else
    enc=(-c:v libx265 -preset "$PRESET" -crf "$CRF" -tag:v hvc1)
  fi
  local -a stats
  # A probe is seconds long and there are three per file, so progress there is
  # noise. The full encode is the one worth reporting on.
  if [[ -n "${PROGRESS_DUR:-}" && "${PROGRESS_DUR}" != "0" && $DRYRUN -eq 0 ]]; then
    stats=(-progress pipe:1 -nostats)
  else
    stats=(-stats)
  fi
  ff=(ffmpeg -hide_banner -loglevel error "${stats[@]}" -nostdin -y
      -i "$src" -map "0:v:0" -an -sn -dn -map_chapters -1
      -vf "$sp"
      "${enc[@]}"
      -pix_fmt "$(pixfmt_for)"
      -color_primaries "$SP_PRIM" -color_trc "$SP_TRC"
      -colorspace "$SP_SPC" -color_range "$SP_RANGE"
      # Audio is muxed in later from the original file by a different tool, so
      # the video timestamps have to survive untouched or the two drift apart.
      -fps_mode passthrough
      "$@" "$dst")
  if [[ $DRYRUN -eq 1 ]]; then
    printf '%q ' "${ff[@]}"; echo
    return 0
  fi
  if [[ -n "${PROGRESS_DUR:-}" && "${PROGRESS_DUR}" != "0" ]]; then
    # ffmpeg writes the progress stream to stdout, so it is consumed here
    # rather than shown. The reader puts the console line on stderr and the
    # machine line on stdout, which keeps --machine output usable by a GUI.
    "${ff[@]}" | python3 -c "$PROGRESS_PY" "$PROGRESS_DUR" "${PROGRESS_NAME:-}" "$MACHINE"
    return "${PIPESTATUS[0]}"
  fi
  "${ff[@]}"
}

# ---------------------------- probe encode ----------------------------------
# Predicting the saving from bitrate and resolution does not work. How much
# HEVC wins depends almost entirely on how tightly the existing file was
# already encoded, and nothing in the metadata says that. So encode a little of
# it and measure. At VideoToolbox speeds this costs seconds.
#
# The sample is cut once with mkvmerge --split parts:, video only, so the
# sample file size is the video size and both the encode and the PSNR
# comparison start on the identical frame.
sample_points() {  # $1 = duration seconds. One "START LENGTH" per line.
  python3 -c '
import sys
dur = float(sys.argv[1]); n = int(sys.argv[2]); ln = int(sys.argv[3])
if dur <= 0:
    sys.exit(1)
# Openings are the cheapest minute of most films and credits are cheaper
# still, so sample the body of it.
if dur < ln * 6:
    pts = [max(0.0, dur / 2 - ln / 2)]
else:
    pts = [dur * f for f in (0.20, 0.45, 0.70)][:n]
for p in pts:
    print("%.3f %d" % (p, min(ln, max(1, int(dur - p)))))
' "$1" "$PROBECOUNT" "$PROBELEN"
}

filesize() { stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null || echo 0; }


# Absolute path without realpath, which stock macOS does not have. Directories
# resolve by cd; files by resolving the directory that holds them.
abspath() {
  local p="$1"
  if [[ -d "$p" ]]; then
    (cd "$p" 2>/dev/null && pwd) || echo "$p"
  else
    local d b
    d="$(dirname "$p")"; b="$(basename "$p")"
    d="$(cd "$d" 2>/dev/null && pwd)" || { echo "$p"; return 0; }
    echo "${d%/}/$b"
  fi
}

# default_flag_args KEEPLIST SOURCE_DEFAULT_ID
# One "ID:FLAG" per line, for every kept track, with exactly one set.
#
# Two faults, not one. Dropping the track that carried the default leaves a
# file with no default, and players then pick whatever they feel like. The
# other direction is just as common and is not caused by this tool: plenty of
# library files already carry the default flag on every subtitle track,
# because whatever built them set it per input file. Keeping three of those
# gives an output with three defaults. Since every kept track is being named
# here anyway, state the flag for all of them rather than only patching the
# case this tool created.
default_flag_args() {
  local keep="$1" srcdef="$2" id chosen=""
  [[ -n "$keep" && "$keep" != "none" ]] || return 0
  if [[ -n "$srcdef" ]]; then
    for id in ${keep//,/ }; do
      [[ "$id" == "$srcdef" ]] && chosen="$id"
    done
  fi
  # The source default did not survive, so promote the first kept track. It is
  # the first in file order, which is the same track a player would have
  # landed on by accident, made explicit.
  [[ -n "$chosen" ]] || chosen="${keep%%,*}"
  for id in ${keep//,/ }; do
    if [[ "$id" == "$chosen" ]]; then echo "${id}:1"; else echo "${id}:0"; fi
  done
}

# probe_encode SRC WORKDIR -> sets PE_RATIO PE_PSNR PE_SSIM
probe_encode() {
  local src="$1" work="$2"
  # A probe writes only to scratch and deletes it again, so it runs even under
  # --dry-run. The alternative is a dry run that reports a saving of 94% for
  # every file because nothing was encoded and the output size was zero, which
  # is worse than reporting nothing. Bash scopes this dynamically, so
  # encode_video below sees the override.
  local DRYRUN=0
  local psrc penc start len n=0 sa=0 sb=0
  local psnrs="" ssims=""
  psrc="$work/probe.src.mkv"
  penc="$work/probe.enc.mkv"

  # Cut with ffmpeg -ss, not "mkvmerge --split parts:". mkvmerge does not seek:
  # it reads the source from byte zero and discards everything outside the
  # windows, so sampling at 70% of a 56 GB remux reads 39 GB across the network
  # before a single frame is encoded, on a file it may then decide to skip.
  # ffmpeg seeks, and the cut takes seconds.
  #
  # A stream copy cannot split mid-GOP, so the window that comes back starts at
  # the keyframe at or before the mark and runs to at least PROBELEN. On a long
  # GOP that is noticeably more than asked for. It costs a little encode time
  # and changes nothing about the result: the ratio is this window's bytes
  # against the encode of this same window, whatever length it turned out to be.
  #
  # The brief rules out -ss when comparing two encodes, because a seek snaps to
  # a keyframe and two runs can start on different frames. That does not apply
  # here. The probe is measured against the window this very cut produced, so
  # both sides start on the same frame by construction. --calibrate still cuts
  # with parts:, because there the whole point is that separate runs line up.
  while read -r start len <&3; do
    [[ -n "$start" ]] || continue
    rm -f "$psrc" "$penc"
    ffmpeg -hide_banner -loglevel error -nostdin -y -ss "$start" -i "$src" \
      -t "$len" -map 0:v:0 -an -sn -dn -map_chapters -1 -c:v copy \
      -avoid_negative_ts make_zero "$psrc" >/dev/null 2>&1 || continue
    [[ -s "$psrc" ]] || continue
    # Check the cut is the length that was asked for. It is read over whatever
    # the source is mounted on, and a short or partial read still produces a
    # perfectly valid small MKV. Its byte ratio is then measured against a
    # fragment and is meaningless, which is invisible once three windows are
    # averaged into one confident-looking number.
    local got
    got="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$psrc" 2>/dev/null || echo 0)"
    if ! python3 -c 'import sys
g=float(sys.argv[1] or 0); w=float(sys.argv[2])
sys.exit(0 if g >= w * 0.5 else 1)' "$got" "$len" 2>/dev/null; then
      warn "probe window at ${start}s came back as ${got}s of a requested ${len}s.
      Discarding it. If this keeps happening the source is not reading
      reliably, and no prediction from it is worth having."
      continue
    fi
    encode_video "$psrc" "$penc" >/dev/null 2>&1 || continue
    local a b
    a="$(filesize "$psrc")"; b="$(filesize "$penc")"
    [[ "$a" -gt 0 && "$b" -gt 0 ]] || continue
    # An encode that stops early is small and scores well: fewer bytes because
    # fewer frames, and the psnr filter ends at the shorter input, so the
    # frames that did encode look excellent. That reads as a spectacular saving
    # and is the most dangerous thing a probe can report, because it argues for
    # re-encoding the file. Compare the durations before believing the ratio.
    local encdur
    encdur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$penc" 2>/dev/null || echo 0)"
    if ! python3 -c 'import sys
e=float(sys.argv[1] or 0); g=float(sys.argv[2] or 0)
sys.exit(0 if g > 0 and e >= g * 0.95 else 1)' "$encdur" "$got" 2>/dev/null; then
      warn "probe encode at ${start}s covered ${encdur}s of a ${got}s window, so it
      stopped early. Discarding it: a short encode looks like a huge saving
      and it is not one."
      continue
    fi
    sa=$((sa + a)); sb=$((sb + b)); n=$((n + 1))
    # The source is the reference here. Unlike ranking two encoders against
    # each other, a shrink has exactly one thing it must not drift from, and
    # this measures that drift directly.
    # Pair frames by index, not by timestamp. A stream copy and a re-encode of
    # the same frames disagree in the millisecond after rounding (0.041 against
    # 0.042), and the psnr filter matches on PTS, so it compares frame N with
    # frame N-1 and reports around 27 dB on content that is actually at 43.
    # That reads exactly like a bad encode and would trip the PSNR floor on
    # perfectly good files. setpts=N discards the timestamps and pairs on
    # position, which is what a frame-to-frame comparison means.
    local p s
    p="$(ffmpeg -hide_banner -nostdin -i "$psrc" -i "$penc" -lavfi "[0:v]setpts=N[a];[1:v]setpts=N[b];[a][b]psnr" \
      -f null - 2>&1 | grep -o 'average:[0-9.]*' | tail -1 | cut -d: -f2 || true)"
    s="$(ffmpeg -hide_banner -nostdin -i "$psrc" -i "$penc" -lavfi "[0:v]setpts=N[a];[1:v]setpts=N[b];[a][b]ssim" \
      -f null - 2>&1 | grep -o 'All:[0-9.]*' | tail -1 | cut -d: -f2 || true)"
    [[ -n "$p" ]] && psnrs="$psnrs $p"
    [[ -n "$s" ]] && ssims="$ssims $s"
    # Name the file on every line. These print before the summary line, so
    # across a library sweep an unlabelled window belongs to whichever file
    # comes next, which is not something anyone should have to work out.
    say "$(basename "$src") probe @${start}s ${got}s: $(python3 -c 'import sys;print("%.0fM -> %.0fM ratio %.4f"%(int(sys.argv[1])/1048576.0,int(sys.argv[2])/1048576.0,int(sys.argv[2])/int(sys.argv[1])))' "$a" "$b") PSNR ${p:-?}"
  done 3< <(sample_points "$DURATION")

  rm -f "$psrc" "$penc"
  if [[ $n -eq 0 || $sa -le 0 ]]; then
    warn "could not cut a sample from $(basename "$src"), so the saving cannot
      be predicted. Encoding it anyway would be a guess, so it is skipped."
    PE_RATIO=""; PE_PSNR=""; PE_SSIM=""; return 1
  fi
  PE_RATIO="$(python3 -c 'import sys;print("%.4f"%(int(sys.argv[2])/int(sys.argv[1])))' "$sa" "$sb")"
  # Report the worst window, not the mean. A file that holds up for two samples
  # and falls apart in the third is a file that falls apart.
  PE_PSNR="$(python3 -c '
import sys
v=[float(x) for x in sys.argv[1].split()]
print("%.4f"%min(v) if v else "")' "$psnrs")"
  PE_SSIM="$(python3 -c '
import sys
v=[float(x) for x in sys.argv[1].split()]
print("%.4f"%min(v) if v else "")' "$ssims")"
  PE_PROBES="$n"
  return 0
}

# ---------------------------- tags and chapters ------------------------------
# Provenance goes into the file. Not ENCODER, which ffprobe overwrites with the
# muxer's writing app by the time anything reads it back. Any MVC2SBS_ tags on
# the source are carried across too: a 3D conversion that then gets shrunk
# should not lose the record of how it was converted.
read -r -d '' TAGMERGE_PY <<'TAGPY' || true
import sys, xml.etree.ElementTree as ET

src, dst, pairs = sys.argv[1], sys.argv[2], sys.argv[3:]
root = None
if src:
    try:
        t = ET.parse(src)
        r = t.getroot()
        if r.tag == "Tags":
            root = r
    except Exception:
        root = None
if root is None:
    root = ET.Element("Tags")

# Drop any earlier MKVSHRINK_ tags: the newest run is the one that describes
# the file, and a stack of them is worse than none.
for tag in list(root.findall("Tag")):
    for simple in list(tag.findall("Simple")):
        name = (simple.findtext("Name") or "")
        if name.startswith("MKVSHRINK_"):
            tag.remove(simple)
    if not tag.findall("Simple"):
        root.remove(tag)

tag = ET.SubElement(root, "Tag")
ET.SubElement(tag, "Targets")
for i in range(0, len(pairs), 2):
    s = ET.SubElement(tag, "Simple")
    ET.SubElement(s, "Name").text = pairs[i]
    ET.SubElement(s, "String").text = pairs[i + 1]
ET.ElementTree(root).write(dst, encoding="utf-8", xml_declaration=True)
TAGPY

# sweep_progress INDEX TOTAL
# A count and a wall-clock estimate for the run as a whole. Weighted by the
# time files have actually taken rather than by file count, because a 56 GB
# grain-heavy remux and a 6 GB anime film are not interchangeable units of
# work and averaging them by count gives an ETA that is wrong all night.
sweep_progress() {
  local idx="$1" tot="$2"
  [[ "$tot" -gt 1 ]] || return 0
  local now elapsed
  now=$(date +%s); elapsed=$(( now - SWEEP_T0 ))
  local msg
  msg="$(python3 -c '
import sys
idx, tot, elapsed = int(sys.argv[1]), int(sys.argv[2]), float(sys.argv[3])
done_bytes = float(sys.argv[4]); todo_bytes = float(sys.argv[5])
if idx <= 0 or elapsed <= 0 or done_bytes <= 0:
    print("%d/%d" % (idx, tot)); raise SystemExit
rate = done_bytes / elapsed
eta = todo_bytes / rate if rate > 0 else 0

def hms(sec):
    sec = int(max(0, sec))
    h, m = sec // 3600, (sec % 3600) // 60
    if h:
        return "%dh%02dm" % (h, m)
    if m:
        return "%dm" % m
    return "%ds" % sec

if idx >= tot:
    print("%d/%d done in %s" % (idx, tot, hms(elapsed)))
else:
    print("%d/%d done, about %s left" % (idx, tot, hms(eta)))
' "$idx" "$tot" "$elapsed" "${SWEEP_BYTES_DONE:-0}" "${SWEEP_BYTES_TODO:-0}")"
  say "Sweep: $msg"
  mach "@@sweep index=$idx total=$tot elapsed=$elapsed done_bytes=${SWEEP_BYTES_DONE:-0} todo_bytes=${SWEEP_BYTES_TODO:-0}"
}

# ---------------------------- progress --------------------------------------
# Reads ffmpeg's -progress key=value stream and turns it into one console line
# and one machine line per update. Scraping the "frame=" status line was the
# alternative; it is positional, changes between ffmpeg releases, and carries
# no explicit end marker. -progress is the interface ffmpeg actually offers for
# this, and a GUI can consume the machine lines without re-parsing prose.
read -r -d '' PROGRESS_PY <<'PROGPY' || true
import sys, time

dur = float(sys.argv[1]) if len(sys.argv) > 1 else 0.0
name = sys.argv[2] if len(sys.argv) > 2 else ""
machine = (len(sys.argv) > 3 and sys.argv[3] == "1")
start = time.time()
cur = {}
last_emit = 0.0

def hms(sec):
    sec = int(max(0, sec))
    h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
    if h:
        return "%dh%02dm" % (h, m)
    if m:
        return "%dm%02ds" % (m, s)
    return "%ds" % s

def emit(final=False):
    # out_time_us is microseconds. Older builds only offer out_time_ms, which
    # despite the name has also been microseconds for years; treat it as a
    # fallback rather than trusting the unit in the key.
    # Every one of these fields arrives as "N/A" in the first block, before
    # the encoder has produced anything. One unguarded float() there kills the
    # reader on line one and the rest of the stream goes to a dead pipe, which
    # looks exactly like progress reporting that was never wired up.
    def num(key, default=0.0):
        v = cur.get(key, "")
        try:
            return float(str(v).strip().rstrip("x"))
        except (TypeError, ValueError):
            return default

    t = 0.0
    if cur.get("out_time_us", "N/A") != "N/A":
        t = num("out_time_us") / 1e6
    elif cur.get("out_time_ms", "N/A") != "N/A":
        t = num("out_time_ms") / 1e6
    spd = num("speed")
    pct = (100.0 * t / dur) if dur > 0 else 0.0
    pct = max(0.0, min(100.0, pct))
    eta = ((dur - t) / spd) if (dur > 0 and spd > 0) else -1
    elapsed = time.time() - start
    fps = cur.get("fps", "0")
    if fps == "N/A":
        fps = "0"
    if machine:
        sys.stdout.write(
            "@@progress file=%s pct=%.1f fps=%s speed=%.2f eta=%d elapsed=%d\n"
            % (name, pct, fps, spd, eta if eta >= 0 else -1, elapsed))
        sys.stdout.flush()
    bar_w = 24
    filled = int(bar_w * pct / 100.0)
    bar = "#" * filled + "." * (bar_w - filled)
    line = "  [%s] %5.1f%%  %s fps  %.2fx  ETA %s" % (
        bar, pct, fps, spd, hms(eta) if eta >= 0 else "?")
    sys.stderr.write("\r\033[K" + line)
    if final:
        sys.stderr.write("\r\033[K")
    sys.stderr.flush()

for raw in sys.stdin:
    line = raw.strip()
    if not line or "=" not in line:
        continue
    k, v = line.split("=", 1)
    cur[k] = v
    if k == "progress":
        now = time.time()
        # ffmpeg emits a block roughly twice a second. Rendering every one of
        # them is fine on a terminal and noise in a log, so throttle.
        if v == "end":
            emit(final=True)
        elif now - last_emit >= 1.0:
            last_emit = now
            emit()
PROGPY

