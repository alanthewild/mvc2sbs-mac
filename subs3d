"""
subs3d - build 3D subtitles for a side-by-side or top-and-bottom movie, from an
         SRT or an existing ASS, and optionally mux them in.

    subs3d dialogue.srt --depth 20 --mux movie.mkv

A player draws an ordinary subtitle once, across the whole frame. On a
side-by-side file that puts half the sentence in each eye. This writes each
line twice, once per eye, so both eyes see the whole line.

Two formats, because no single one plays everywhere:

  ASS   text, styled by the player. Small, restylable, and correct in VLC, mpv,
        Kodi and Infuse. ExoPlayer's support is partial, so Jellyfin on a
        Shield will probably ignore the positioning or burn it in.
  PGS   bitmaps, the Blu-ray format. The typeface is baked in, so it looks the
        same everywhere and needs no font on the player. This is what a disc
        carries and what direct plays on a Shield.

The default writes both and lets the player choose. The mux is free either way:
nothing is re-encoded.

Requires python3 always. The PGS renderer needs ffmpeg built with libass;
--mux needs ffprobe and mkvmerge.
"""

import argparse
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile

VERSION = "3.62"

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

CYAN, YELLOW, RED, OFF = "\033[1;36m", "\033[1;33m", "\033[1;31m", "\033[0m"


def say(msg):
    sys.stderr.write("%s==>%s %s\n" % (CYAN, OFF, msg))


def warn(msg):
    sys.stderr.write("%sWARN:%s %s\n" % (YELLOW, OFF, msg))


def die(msg):
    sys.stderr.write("%sERROR:%s %s\n" % (RED, OFF, msg))
    raise SystemExit(1)


def need(tool, hint):
    if shutil.which(tool) is None:
        die("%s not found in PATH. %s" % (tool, hint))


# --------------------------------------------------------------------------
# Reading subtitles in
# --------------------------------------------------------------------------

def srt_time(t):
    h, m, rest = t.split(":")
    s, ms = rest.replace(".", ",").split(",")
    return int(h) * 3600 + int(m) * 60 + int(s) + int(ms) / 1000.0


def ass_time(sec):
    if sec < 0:
        sec = 0
    h = int(sec // 3600)
    m = int((sec % 3600) // 60)
    return "%d:%02d:%05.2f" % (h, m, sec % 60)


def read_srt(text):
    """(start, end, text) per cue. Line breaks become \\N."""
    out = []
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    for b in re.split(r"\n\s*\n", text):
        lines = [l for l in b.split("\n") if l.strip()]
        if lines and re.match(r"^\d+$", lines[0].strip()):
            lines = lines[1:]
        if not lines:
            continue
        m = re.match(r"\s*([\d:,.]+)\s*-->\s*([\d:,.]+)", lines[0])
        if not m:
            continue
        body = "\\N".join(l.strip() for l in lines[1:])
        # SRT allows a little HTML. ASS has its own tags for the same things.
        body = body.replace("<i>", "{\\i1}").replace("</i>", "{\\i0}")
        body = body.replace("<b>", "{\\b1}").replace("</b>", "{\\b0}")
        body = re.sub(r"<[^>]+>", "", body)
        if body:
            out.append((srt_time(m.group(1)), srt_time(m.group(2)), body, "Default"))
    return out


def read_ass(text):
    """Cues, the style lines, and the canvas the file was authored for."""
    events, styles, play = [], [], {}
    fmt, section = None, ""
    for line in text.replace("\r\n", "\n").split("\n"):
        s = line.strip()
        low = s.lower()
        if s.startswith("["):
            section = low
            continue
        if section == "[script info]":
            m = re.match(r"(?i)(playresx|playresy)\s*:\s*(\d+)", s)
            if m:
                play[m.group(1).lower()] = int(m.group(2))
        elif "styles" in section and low.startswith("style:"):
            styles.append(s)
        elif section == "[events]":
            if low.startswith("format:"):
                fmt = [f.strip().lower() for f in s.split(":", 1)[1].split(",")]
            elif low.startswith("dialogue:") and fmt:
                parts = s.split(":", 1)[1].split(",", len(fmt) - 1)
                row = dict(zip(fmt, [p.strip() for p in parts]))
                try:
                    events.append((srt_time(row.get("start", "0:00:00.00")),
                                   srt_time(row.get("end", "0:00:00.00")),
                                   row.get("text", ""),
                                   row.get("style", "Default")))
                except Exception:
                    continue
    return events, styles, play


def load(path):
    raw = open(path, encoding="utf-8-sig", errors="replace").read()
    if "[events]" in raw.lower():
        return read_ass(raw)
    return read_srt(raw), [], {}


# --------------------------------------------------------------------------
# Writing ASS out
# --------------------------------------------------------------------------

DEFAULT_STYLE = (
    "Style: Default,{font},{size},&H00FFFFFF,&H000000FF,&H00000000,&H80000000,"
    "0,0,0,0,{scalex},100,0,0,1,{outline},1,2,60,60,{margin},1")

# \pos and \move decide placement, and this tool is deciding placement, so any
# that came in have to go or the two copies land on top of each other.
STRIP = re.compile(r"\\(?:pos|move)\s*\([^)]*\)|\\an\d|\\a\d+")


def clean(text):
    return re.sub(r"\{\s*\}", "", STRIP.sub("", text))


def scale_styles(styles, factor):
    """Fontsize, outline, shadow and margins are in the source's own units."""
    out = []
    for st in styles:
        head, _, body = st.partition(":")
        f = [p.strip() for p in body.split(",")]
        for i in (2, 16, 17, 19, 20, 21):     # V4+ field positions
            if i < len(f):
                try:
                    f[i] = str(int(round(float(f[i]) * factor)))
                except ValueError:
                    pass
        out.append(head + ": " + ",".join(f))
    return out


ASS_HEADER = """[Script Info]
; Written by subs3d {version}. {note}
ScriptType: v4.00+
WrapStyle: 0
ScaledBorderAndShadow: yes
YCbCr Matrix: TV.709
PlayResX: {width}
PlayResY: {height}

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
{styles}

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""


def write_ass(path, cues, styles, width, height, origins, note):
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(ASS_HEADER.format(version=VERSION, note=note, width=width,
                                   height=height, styles="\n".join(styles)))
        for start, end, text, style in cues:
            for x, y in origins:
                fh.write("Dialogue: 0,%s,%s,%s,,0,0,0,,{\\an2\\pos(%d,%d)}%s\n"
                         % (ass_time(start), ass_time(end), style, x, y, clean(text)))


# --------------------------------------------------------------------------
# Writing PGS out
# --------------------------------------------------------------------------
# libass renders each line onto a transparent canvas, ffmpeg turns the result
# into two 8 bit planes, and those become a palette index per pixel. No pixel
# is examined in Python: the index is built with bytes.translate and combined
# with big integer masking, both of which run in C. A feature film's worth of
# subtitles takes seconds rather than the ten minutes a per pixel loop needs.

PDS, ODS, PCS, WDS, END = 0x14, 0x15, 0x16, 0x17, 0x80
PG_HEADER = struct.Struct(">2sIIBH")

# 0 draws nothing. 1..127 is the fill, white, ramping in alpha. 128..254 is the
# outline, black, doing the same. Two ramps in one 8 bit index means the
# antialiased edges of both survive, which is what stops the text looking
# ragged against a bright scene.
FILL_LO, FILL_HI = 1, 127
LINE_LO, LINE_HI = 128, 254


def build_palette():
    """(index, Y, Cr, Cb, A) entries for the two ramps."""
    entries = []
    for i in range(FILL_LO, FILL_HI + 1):
        a = int(round((i - FILL_LO + 1) * 255.0 / (FILL_HI - FILL_LO + 1)))
        entries.append((i, 235, 128, 128, min(255, a)))
    for i in range(LINE_LO, LINE_HI + 1):
        a = int(round((i - LINE_LO + 1) * 255.0 / (LINE_HI - LINE_LO + 1)))
        entries.append((i, 16, 128, 128, min(255, a)))
    return entries


def pds_payload():
    out = bytearray([0, 0])
    for idx, y, cr, cb, a in build_palette():
        out += bytes([idx, y, cr, cb, a])
    return bytes(out)


TBL_FILL = bytes([0] + [FILL_LO + (v * (FILL_HI - FILL_LO)) // 255 for v in range(1, 256)])
TBL_LINE = bytes([0] + [LINE_LO + (v * (LINE_HI - LINE_LO)) // 255 for v in range(1, 256)])
# libass composites onto the transparent canvas with premultiplied alpha, so
# the red channel of a white glyph is already coverage times 255, and a black
# outline is 0 no matter how opaque it is. That makes red the fill coverage
# and red > 0 the test for "this pixel is fill". Thresholding red at 128 was
# wrong: it read every antialiased edge of the white text as outline, and the
# whole fill collapsed to a single opaque index.
TBL_FILLMASK = bytes([0x00] + [0xFF] * 255)
TBL_LINEMASK = bytes([0xFF] + [0x00] * 255)


def index_plane(red, alpha):
    """One palette index per pixel, entirely in C.

    Where alpha is 0 red is 0 too, so both ramps give 0 and nothing that was
    never drawn can be resurrected by the masks.
    """
    n = len(alpha)
    fill = int.from_bytes(red.translate(TBL_FILL), "big")
    line = int.from_bytes(alpha.translate(TBL_LINE), "big")
    keep_fill = int.from_bytes(red.translate(TBL_FILLMASK), "big")
    keep_line = int.from_bytes(red.translate(TBL_LINEMASK), "big")
    return ((fill & keep_fill) | (line & keep_line)).to_bytes(n, "big")


def encode_rle(rows, width):
    """PGS run length coding. See pgs3d.py for the format."""
    out = bytearray()
    for row in rows:
        x, n = 0, len(row)
        while x < n:
            colour = row[x]
            run = 1
            while x + run < n and row[x + run] == colour:
                run += 1
            x += run
            if colour == 0:
                while run > 0:
                    k = min(run, 0x3FFF)
                    if k <= 0x3F:
                        out += bytes((0, k))
                    else:
                        out += bytes((0, 0x40 | (k >> 8), k & 0xFF))
                    run -= k
            else:
                while run > 0:
                    k = min(run, 0x3FFF)
                    if k <= 2:
                        out += bytes([colour]) * k
                    elif k <= 0x3F:
                        out += bytes((0, 0x80 | k, colour))
                    else:
                        out += bytes((0, 0xC0 | (k >> 8), k & 0xFF, colour))
                    run -= k
        out += b"\x00\x00"
    return bytes(out)


def segment(pts, kind, payload):
    return PG_HEADER.pack(b"PG", int(round(pts * 90000)), 0, kind,
                          len(payload)) + payload


def render_bitmaps(cues, styles, eye_w, eye_h, band, workdir, chunk=200):
    """One bitmap per cue: (x, y, width, height, rle) or None for an empty one.

    Every cue is drawn on its own second of a synthetic timeline, so one ffmpeg
    run produces one frame per cue. Rendering them one at a time would mean an
    ffmpeg launch per line of dialogue.
    """
    top = max(0, eye_h - band)
    results = [None] * len(cues)

    for base in range(0, len(cues), chunk):
        part = cues[base:base + chunk]
        script = os.path.join(workdir, "render.ass")
        with open(script, "w", encoding="utf-8") as fh:
            fh.write(ASS_HEADER.format(version=VERSION, note="render pass",
                                       width=eye_w, height=eye_h,
                                       styles="\n".join(styles)))
            for i, (_s, _e, text, style) in enumerate(part):
                # Frames land on whole seconds at 1 fps, so cue i has to be on
                # screen AT second i. A cue that merely overlaps the second,
                # 0.25 to 0.75, is drawn on no frame at all and renders blank.
                fh.write("Dialogue: 0,%s,%s,%s,,0,0,0,,%s\n"
                         % (ass_time(i), ass_time(i + 0.9), style, clean(text)))

        red = os.path.join(workdir, "r.raw")
        alpha = os.path.join(workdir, "a.raw")
        cmd = [
            "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
            "-f", "lavfi",
            "-i", "color=c=black@0.0:s=%dx%d:r=1:d=%d,format=yuva420p"
                  % (eye_w, eye_h, len(part)),
            "-filter_complex",
            "[0:v]ass=%s:alpha=1,format=rgba,crop=%d:%d:0:%d,extractplanes=r+a[r][a]"
            % (script.replace("\\", "\\\\").replace(":", "\\:"), eye_w, eye_h - top, top),
            "-map", "[r]", "-f", "rawvideo", "-pix_fmt", "gray", red,
            "-map", "[a]", "-f", "rawvideo", "-pix_fmt", "gray", alpha,
        ]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            die("ffmpeg could not render the subtitles:\n" + (r.stderr or "").strip())

        frame = eye_w * (eye_h - top)
        rbuf = open(red, "rb").read()
        abuf = open(alpha, "rb").read()
        if len(abuf) < frame * len(part):
            die("ffmpeg produced %d bytes of subtitle bitmap, expected %d. "
                "Is this ffmpeg built with libass?"
                % (len(abuf), frame * len(part)))

        for i in range(len(part)):
            off = i * frame
            plane = index_plane(rbuf[off:off + frame], abuf[off:off + frame])
            rows = [plane[y * eye_w:(y + 1) * eye_w] for y in range(eye_h - top)]

            live = [y for y, row in enumerate(rows) if row.strip(b"\x00")]
            if not live:
                continue
            y0, y1 = live[0], live[-1] + 1
            x0, x1 = eye_w, 0
            for row in rows[y0:y1]:
                stripped = row.rstrip(b"\x00")
                if not stripped:
                    continue
                lead = len(row) - len(row.lstrip(b"\x00"))
                x0 = min(x0, lead)
                x1 = max(x1, len(stripped))
            cropped = [row[x0:x1] for row in rows[y0:y1]]
            results[base + i] = (x0, top + y0, x1 - x0, y1 - y0,
                                 encode_rle(cropped, x1 - x0))
        os.remove(red)
        os.remove(alpha)
    return results


def write_sup(path, cues, bitmaps, eye_w, eye_h):
    """A .sup at the size of one eye. pgs3d does the duplication."""
    import pgs3d

    out = bytearray()
    drawn = 0
    for (start, end, _t, _st), bm in zip(cues, bitmaps):
        if bm is None:
            continue
        x, y, w, h, rle = bm
        drawn += 1
        pcs = struct.pack(">HHBHBBBB", eye_w, eye_h, 0x10, drawn & 0xFFFF, 0x80, 0, 0, 1)
        pcs += struct.pack(">HBBHH", 0, 0, 0, x, y)
        out += segment(start, PCS, pcs)
        out += segment(start, WDS, bytes([1]) + struct.pack(">BHHHH", 0, x, y, w, h))
        out += segment(start, PDS, pds_payload())
        for frag in pgs3d.build_ods(0, 0, w, h, rle):
            out += segment(start, ODS, frag)
        out += segment(start, END, b"")

        clear = struct.pack(">HHBHBBBB", eye_w, eye_h, 0x10, drawn & 0xFFFF, 0x00, 0, 0, 0)
        out += segment(end, PCS, clear)
        out += segment(end, WDS, bytes([1]) + struct.pack(">BHHHH", 0, x, y, w, h))
        out += segment(end, END, b"")

    open(path, "wb").write(bytes(out))
    return drawn


# --------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(
        prog="subs3d",
        description="3D subtitles for a side-by-side or top-and-bottom movie",
        epilog="Check the result before you commit to it. Depth is a matter of "
               "taste and of how the film was shot.")
    ap.add_argument("input", help="an .srt or an .ass")
    ap.add_argument("-o", dest="out", default="",
                    help="output file (default: the input name with .3d)")
    ap.add_argument("--format", choices=["both", "ass", "pgs"], default="both",
                    help="both writes a bitmap track and a text track and lets "
                         "the player choose (default)")
    ap.add_argument("--width", type=int, default=3840, help="movie width")
    ap.add_argument("--height", type=int, default=1080, help="movie height")
    ap.add_argument("--layout", choices=["fsbs", "ftab"], default="fsbs")
    ap.add_argument("--depth", type=int, default=0,
                    help="horizontal disparity in pixels. Positive brings the "
                         "subtitles towards the viewer, which stops them "
                         "colliding with anything popping out. 20 to 40 is a "
                         "sensible range, 0 is screen depth")
    ap.add_argument("--margin", type=int, default=60,
                    help="distance from the bottom of each eye")
    ap.add_argument("--band", type=int, default=400,
                    help="how many pixels up from the bottom of each eye can "
                         "hold subtitles. Only affects the PGS renderer")
    ap.add_argument("--font", default="", help="override the font")
    ap.add_argument("--size", type=int, default=0, help="override the font size")
    ap.add_argument("--scale-x", dest="scalex", type=int, default=100,
                    help="horizontal scale percent, for a player that stretches")
    ap.add_argument("--mux", default="", help="also write MOVIE.3dsubs.mkv")
    ap.add_argument("--language", default="eng")
    ap.add_argument("--track-name", dest="trackname", default="")
    ap.add_argument("-V", "--version", action="version",
                    version="subs3d " + VERSION)
    args = ap.parse_args()

    if not os.path.exists(args.input):
        die("no such file: " + args.input)

    width, height, layout = args.width, args.height, args.layout
    wants_pgs = args.format in ("both", "pgs")
    wants_ass = args.format in ("both", "ass")

    if wants_pgs:
        need("ffmpeg", "brew install ffmpeg")
    if args.mux:
        need("ffprobe", "brew install ffmpeg")
        need("mkvmerge", "brew install mkvtoolnix")
        if not os.path.exists(args.mux):
            die("no such file: " + args.mux)
        probe = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "csv=p=0", args.mux],
            capture_output=True, text=True).stdout.strip()
        m = re.match(r"^(\d+),(\d+)$", probe)
        if m:
            width, height = int(m.group(1)), int(m.group(2))
            say("Movie is %dx%d" % (width, height))
            if height > 1200 and width <= 2048:
                layout = "ftab"
                say("Taller than it is wide for a feature, so assuming top and bottom")

    # Each half of a Full layout is a complete picture at its own resolution, so
    # nothing is rescaled: text drawn at 1080p proportions in one half looks the
    # same as it would on a 2D copy of the film.
    if layout == "fsbs":
        eye_w, eye_h = width // 2, height
        origins = [(eye_w // 2 + args.depth // 2, eye_h - args.margin),
                   (eye_w + eye_w // 2 - (args.depth - args.depth // 2),
                    eye_h - args.margin)]
    else:
        eye_w, eye_h = width, height // 2
        origins = [(eye_w // 2 + args.depth // 2, eye_h - args.margin),
                   (eye_w // 2 - (args.depth - args.depth // 2),
                    eye_h + eye_h - args.margin)]

    cues, styles, play = load(args.input)
    if not cues:
        die("no subtitles found in " + os.path.basename(args.input))

    factor = eye_h / float(play.get("playresy") or 1080)
    if styles and not (args.font or args.size):
        styles = scale_styles(styles, factor)
    else:
        styles = [DEFAULT_STYLE.format(
            font=args.font or "Arial",
            size=args.size or int(round(54 * factor)),
            scalex=args.scalex,
            outline=max(1, int(round(3 * factor))),
            margin=args.margin)]

    say("subs3d %s" % VERSION)
    say("%s, %dx%d, depth %dpx, format %s"
        % (layout, width, height, args.depth, args.format))

    stem = args.out or (os.path.splitext(args.input)[0] + ".3d")
    stem = re.sub(r"\.(ass|sup)$", "", stem)
    written = []

    if wants_ass:
        ass_path = stem + ".ass"
        write_ass(ass_path, cues, styles, width, height, origins,
                  "Two copies of every line, one per eye.")
        say("Wrote %s  (%d lines, each twice)" % (os.path.basename(ass_path), len(cues)))
        written.append((ass_path, "3D subtitles (text)"))

    if wants_pgs:
        sup_path = stem + ".sup"
        with tempfile.TemporaryDirectory(prefix="subs3d.") as tmp:
            say("Rendering %d lines to bitmaps" % len(cues))
            bitmaps = render_bitmaps(cues, styles, eye_w, eye_h, args.band, tmp)
            blank = sum(1 for b in bitmaps if b is None)
            if blank:
                warn("%d line(s) rendered blank and were dropped. If that is all "
                     "of them, the font is missing or --band is too small." % blank)
            flat = os.path.join(tmp, "flat.sup")
            drawn = write_sup(flat, cues, bitmaps, eye_w, eye_h)
            if not drawn:
                die("nothing rendered. Check the font with: fc-list")

            import pgs3d
            data = open(flat, "rb").read()
            if layout == "fsbs":
                out, stats = pgs3d.convert(data, width, args.depth)
            else:
                out, stats = pgs3d.convert(data, width, args.depth,
                                           stack=True, out_height=height)
            open(sup_path, "wb").write(out)
        say("Wrote %s  (%d display sets, %d objects merged into both eyes)"
            % (os.path.basename(sup_path), stats["display_sets"], stats["objects"]))
        written.append((sup_path, "3D subtitles"))

    if args.mux:
        base = args.mux[:-4] if args.mux.endswith(".mkv") else args.mux
        muxout = base + ".3dsubs.mkv"
        say("Muxing into %s. Nothing is re-encoded." % os.path.basename(muxout))
        cmd = ["mkvmerge", "-q", "-o", muxout, args.mux]
        for path, name in written:
            cmd += ["--language", "0:" + args.language,
                    "--track-name", "0:" + (args.trackname or name), path]
        r = subprocess.run(cmd, capture_output=True, text=True)
        note = (r.stdout or "") + (r.stderr or "")
        # 1 is warnings and the file is fine, 2 is a real failure.
        if r.returncode == 1 and os.path.exists(muxout) and os.path.getsize(muxout):
            warn("mkvmerge reported warnings. The file is fine:")
            sys.stderr.write("".join("      " + l + "\n" for l in note.splitlines()))
        elif r.returncode != 0:
            sys.stderr.write("".join("      " + l + "\n" for l in note.splitlines()))
            die("mkvmerge exited %d" % r.returncode)
        say("Done: " + muxout)

    say("Check it before you commit to it. Depth is a matter of taste, and a "
        "player that ignores \\pos will stack both ASS copies in the middle.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
